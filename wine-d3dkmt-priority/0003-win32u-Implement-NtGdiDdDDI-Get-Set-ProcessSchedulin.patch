+/******************************************************************************
+ *           NtGdiDdDDISetProcessSchedulingPriorityClass    (win32u.@)
+ */
+NTSTATUS WINAPI NtGdiDdDDISetProcessSchedulingPriorityClass( HANDLE process, D3DKMT_SCHEDULINGPRIORITYCLASS priority )
+{
+    static int once;
+    NTSTATUS status;
+
+    TRACE( "(%p, %d)\n", process, priority );
+
+    if ((UINT)priority > D3DKMT_SCHEDULINGPRIORITYCLASS_REALTIME) return STATUS_INVALID_PARAMETER;
+
+    SERVER_START_REQ( d3dkmt_set_process_priority )
+    {
+        req->handle   = wine_server_obj_handle( process );
+        req->priority = priority;
+        status = wine_server_call( req );
+    }
+    SERVER_END_REQ;
+
+    if (!status && priority != D3DKMT_SCHEDULINGPRIORITYCLASS_NORMAL && !once++)
+        FIXME( "priority class %d is only stored, GPU scheduling is not affected\n", priority );
+    return status;
+}
+
+/******************************************************************************
+ *           NtGdiDdDDIGetProcessSchedulingPriorityClass    (win32u.@)
+ */
+NTSTATUS WINAPI NtGdiDdDDIGetProcessSchedulingPriorityClass( HANDLE process, D3DKMT_SCHEDULINGPRIORITYCLASS *priority )
+{
+    NTSTATUS status;
+
+    TRACE( "(%p, %p)\n", process, priority );
+
+    if (!priority) return STATUS_INVALID_PARAMETER;
+
+    SERVER_START_REQ( d3dkmt_get_process_priority )
+    {
+        req->handle = wine_server_obj_handle( process );
+        if (!(status = wine_server_call( req ))) *priority = reply->priority;
+    }
+    SERVER_END_REQ;
+
+    return status;
+}
