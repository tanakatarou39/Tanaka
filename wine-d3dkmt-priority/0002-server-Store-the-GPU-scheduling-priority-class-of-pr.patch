+/* Set the GPU scheduling priority class of a process */
+@REQ(d3dkmt_set_process_priority)
+    obj_handle_t        handle;         /* process handle */
+    int                 priority;       /* D3DKMT_SCHEDULINGPRIORITYCLASS value */
