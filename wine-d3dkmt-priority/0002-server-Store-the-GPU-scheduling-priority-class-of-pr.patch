diff --git a/server/d3dkmt.c b/server/d3dkmt.c
index 1bf746c..ec3b9db 100644
--- a/server/d3dkmt.c
+++ b/server/d3dkmt.c
@@ -31,6 +31,7 @@
 
 #include "file.h"
 #include "handle.h"
+#include "process.h"
 #include "request.h"
 #include "security.h"
 
@@ -721,3 +722,29 @@ DECL_HANDLER(d3dkmt_mutex_release)
 
     release_object( mutex );
 }
+
+/* Set the GPU scheduling priority class of a process */
+DECL_HANDLER(d3dkmt_set_process_priority)
+{
+    struct process *process;
+
+    if (!(process = get_process_from_handle( req->handle, PROCESS_SET_INFORMATION ))) return;
+
+    if (req->priority == 5 /* D3DKMT_SCHEDULINGPRIORITYCLASS_REALTIME */ &&
+        !thread_single_check_privilege( current, SeIncreaseBasePriorityPrivilege ))
+        set_error( STATUS_PRIVILEGE_NOT_HELD );
+    else
+        process->gpu_priority = req->priority;
+
+    release_object( process );
+}
+
+/* Get the GPU scheduling priority class of a process */
+DECL_HANDLER(d3dkmt_get_process_priority)
+{
+    struct process *process;
+
+    if (!(process = get_process_from_handle( req->handle, PROCESS_QUERY_LIMITED_INFORMATION ))) return;
+    reply->priority = process->gpu_priority;
+    release_object( process );
+}
diff --git a/server/process.c b/server/process.c
index f1a8c06..6c3c1fe 100644
--- a/server/process.c
+++ b/server/process.c
@@ -619,6 +619,7 @@ struct process *create_process( int fd, struct process *parent, unsigned int fla
     process->priority        = PROCESS_PRIOCLASS_NORMAL;
     process->base_priority   = 8;
     process->disable_boost   = 0;
+    process->gpu_priority    = 2; /* D3DKMT_SCHEDULINGPRIORITYCLASS_NORMAL */
     process->suspend         = 0;
     process->is_system       = 0;
     process->debug_children  = 1;
diff --git a/server/process.h b/server/process.h
index dff766d..b05bbae 100644
--- a/server/process.h
+++ b/server/process.h
@@ -61,6 +61,7 @@ struct process
     int                  priority;        /* priority class */
     int                  base_priority;   /* base priority to calculate thread priority */
     int                  disable_boost;   /* disable priority boost */
+    int                  gpu_priority;    /* GPU scheduling priority class */
     int                  suspend;         /* global process suspend count */
     unsigned int         is_system:1;     /* is it a system process? */
     unsigned int         debug_children:1;/* also debug all child processes */
diff --git a/server/protocol.def b/server/protocol.def
index 63b5cfd..8bc4a1f 100644
--- a/server/protocol.def
+++ b/server/protocol.def
@@ -4342,6 +4342,21 @@ enum inproc_sync_type
