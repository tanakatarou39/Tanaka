From d4322e00c9d4af5b871be1b476d378e6766d53a9 Mon Sep 17 00:00:00 2001
From: chatgptyukkuri <chatgptyukkuri@gmail.com>
Date: Wed, 28 Oct 2026 03:24:53 +0000
Subject: [PATCH 06/14] vkd3d-shader/fx: Write zero element count for fx_2_0
 constant state values.

The value is not an array, this matches what the native compiler produces.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01LkAyMz3ChWUcwV1bWoNa1Z
---
 libs/vkd3d-shader/fx.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/libs/vkd3d-shader/fx.c b/libs/vkd3d-shader/fx.c
index 1e822bed..1d34e6cb 100644
--- a/libs/vkd3d-shader/fx.c
+++ b/libs/vkd3d-shader/fx.c
@@ -2233,7 +2233,7 @@ static uint32_t write_fx_2_state_type(const struct hlsl_state_block_entry *entry
     put_u32(buffer, D3DXPC_MATRIX_ROWS);
     put_u32(buffer, 0); /* Name */
     put_u32(buffer, 0); /* Semantic */
-    put_u32(buffer, 1); /* Element count */
+    put_u32(buffer, 0); /* Element count */
 
     put_u32(buffer, entry->args_count); /* Rows */
     put_u32(buffer, 1); /* Columns */
