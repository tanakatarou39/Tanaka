From 25c90bee590be44c6cdbc625cfb71ac5d83352db Mon Sep 17 00:00:00 2001
From: chatgptyukkuri <chatgptyukkuri@gmail.com>
Date: Thu, 29 Oct 2026 12:04:12 +0000
Subject: [PATCH 14/14] vkd3d-shader/fx: Support array selectors in fx_2_0
 state assignments.

Elements of parameter arrays selected with a non-constant index, e.g.
"VertexShader = vs_arr[i];", are written as array selectors. The index is
computed by a fxlvm code blob which follows the name of the array.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01LkAyMz3ChWUcwV1bWoNa1Z
---
 libs/vkd3d-shader/fx.c                        | 155 ++++++++++++------
 .../hlsl/effect-assignments-fx_2.shader_test  |   8 +-
 2 files changed, 113 insertions(+), 50 deletions(-)

diff --git a/libs/vkd3d-shader/fx.c b/libs/vkd3d-shader/fx.c
index 7988e404..09e19163 100644
--- a/libs/vkd3d-shader/fx.c
+++ b/libs/vkd3d-shader/fx.c
@@ -2314,12 +2314,12 @@ static uint32_t write_fx_2_state_numeric_type(const struct hlsl_type *type, stru
     return offset;
 }
 
-static uint32_t write_fx_2_reference_assignment(const struct hlsl_ir_var *var, const struct hlsl_type *type,
-        const char *name, uint32_t *type_offset, struct fx_write_context *fx)
+/* Writes the type and the value of a state which refers to a parameter. */
+static bool write_fx_2_reference_value(const struct hlsl_ir_var *var, const struct hlsl_type *type,
+        uint32_t *offset, uint32_t *type_offset, struct fx_write_context *fx)
 {
     struct vkd3d_bytecode_buffer *buffer = &fx->unstructured;
     struct hlsl_ctx *ctx = fx->ctx;
-    uint32_t offset = 0;
 
     switch (type->class)
     {
@@ -2330,33 +2330,47 @@ static uint32_t write_fx_2_reference_assignment(const struct hlsl_ir_var *var, c
         case HLSL_CLASS_TEXTURE:
         case HLSL_CLASS_STRING:
             *type_offset = write_fx_2_state_object_type(type, fx);
-            offset = put_u32(buffer, fx->object_variable_count++);
-            break;
+            *offset = put_u32(buffer, fx->object_variable_count++);
+            return true;
 
         case HLSL_CLASS_SCALAR:
         case HLSL_CLASS_VECTOR:
         case HLSL_CLASS_MATRIX:
             /* The value is not used, the referenced parameter provides it. */
             *type_offset = write_fx_2_state_numeric_type(type, fx);
-            offset = buffer->size;
+            *offset = buffer->size;
             for (unsigned int i = 0; i < hlsl_type_component_count(type); ++i)
                 put_u32(buffer, 0);
-            break;
+            return true;
 
         default:
             hlsl_fixme(ctx, &var->loc, "Writing references to variables of class %#x is not implemented.",
                     type->class);
-            return 0;
+            return false;
     }
+}
+
+static uint32_t write_fx_2_reference_assignment(const struct hlsl_ir_var *var, const struct hlsl_type *type,
+        const char *name, uint32_t *type_offset, struct fx_write_context *fx)
+{
+    uint32_t offset;
+
+    if (!write_fx_2_reference_value(var, type, &offset, type_offset, fx))
+        return 0;
 
     write_fx_2_resource(FX_2_ASSIGNMENT_PARAMETER, name, strlen(name) + 1, fx);
 
     return offset;
 }
 
-static uint32_t write_fx_2_index_assignment(const struct hlsl_ir_var *var, const struct hlsl_ir_index *index,
-        uint32_t *type, struct fx_write_context *fx)
+static uint32_t write_fx_2_array_selector_assignment(const struct hlsl_ir_var *var,
+        const struct hlsl_state_block_entry *entry, const struct hlsl_ir_index *index,
+        uint32_t *type, struct fx_write_context *fx);
+
+static uint32_t write_fx_2_index_assignment(const struct hlsl_ir_var *var,
+        const struct hlsl_state_block_entry *entry, uint32_t *type, struct fx_write_context *fx)
 {
+    const struct hlsl_ir_index *index = hlsl_ir_index(entry->args->node);
     struct hlsl_ir_node *val = index->val.node, *idx = index->idx.node;
     const struct hlsl_ir_var *ref;
     struct hlsl_ctx *ctx = fx->ctx;
@@ -2371,10 +2385,7 @@ static uint32_t write_fx_2_index_assignment(const struct hlsl_ir_var *var, const
     }
 
     if (idx->type != HLSL_IR_CONSTANT)
-    {
-        hlsl_fixme(ctx, &var->loc, "Non-constant array indices in RHS values are not implemented.");
-        return 0;
-    }
+        return write_fx_2_array_selector_assignment(var, entry, index, type, fx);
 
     ref = hlsl_ir_load(val)->src.var;
     element = hlsl_ir_constant(idx)->value.u[0].u;
@@ -3434,28 +3445,19 @@ static void fxlc_writer_cleanup(struct fxlc_writer *writer)
     vkd3d_free(writer->inputs);
 }
 
-static uint32_t write_fx_2_expression_assignment(const struct hlsl_ir_var *var,
-        const struct hlsl_state_block_entry *entry, uint32_t *type, struct fx_write_context *fx)
+/* Writes a fxlvm code blob which computes the value of a node of the block. */
+static bool write_fxlc_blob(const struct hlsl_ir_var *var, const struct hlsl_block *block,
+        const struct hlsl_ir_node *value, struct vkd3d_bytecode_buffer *blob, struct fx_write_context *fx)
 {
-    const struct hlsl_ir_node *value = entry->args->node, *instr;
-    struct vkd3d_bytecode_buffer *unstructured = &fx->unstructured;
-    struct fxlc_writer writer = {.fx = fx, .var = var};
-    struct vkd3d_bytecode_buffer blob = { 0 };
+    unsigned int comp_count = hlsl_type_component_count(value->data_type);
     struct fxlc_operand output[FXLC_MAX_COMPONENTS], base;
-    unsigned int comp_count;
-    uint32_t offset;
-
-    /* Matrices are written in row-major order. */
-    if (entry->args_count != 1 || !hlsl_is_numeric_type(value->data_type))
-    {
-        hlsl_fixme(fx->ctx, &var->loc, "Unhandled expression for state %s.", entry->name);
-        return 0;
-    }
-    comp_count = hlsl_type_component_count(value->data_type);
+    struct fxlc_writer writer = {.fx = fx, .var = var};
+    const struct hlsl_ir_node *instr;
+    bool ret = false;
 
-    fxlc_compute_liveness(&writer, entry->instrs, value);
+    fxlc_compute_liveness(&writer, block, value);
 
-    LIST_FOR_EACH_ENTRY(instr, &entry->instrs->instrs, struct hlsl_ir_node, entry)
+    LIST_FOR_EACH_ENTRY(instr, &block->instrs, struct hlsl_ir_node, entry)
     {
         if (!fxlc_is_live_instr(&writer, instr))
             continue;
@@ -3495,6 +3497,7 @@ static uint32_t write_fx_2_expression_assignment(const struct hlsl_ir_var *var,
 
         if (src)
         {
+            /* Matrices are written in row-major order. */
             base = (struct fxlc_operand){FX_FXLC_REG_OUTPUT, 0};
             fxlc_set_consecutive_components(output, &base, comp_count);
             fxlc_write_componentwise(&writer, FX_FXLC_OP_MOV, comp_count, output, &src, 1);
@@ -3506,33 +3509,81 @@ static uint32_t write_fx_2_expression_assignment(const struct hlsl_ir_var *var,
         /* Literals are allocated in complete registers. */
         writer.literal_count = align(writer.literal_count, 4);
 
-        put_u32(&blob, TAG_FX20);
-        fxlc_write_ctab(&writer, &blob);
+        put_u32(blob, TAG_FX20);
+        fxlc_write_ctab(&writer, blob);
 
         /* Literals are stored as doubles. */
-        fxlc_put_comment_header(&blob, TAG_CLIT, sizeof(uint32_t) + writer.literal_count * sizeof(double));
-        put_u32(&blob, writer.literal_count);
-        bytecode_put_bytes(&blob, writer.literals, writer.literal_count * sizeof(*writer.literals));
+        fxlc_put_comment_header(blob, TAG_CLIT, sizeof(uint32_t) + writer.literal_count * sizeof(double));
+        put_u32(blob, writer.literal_count);
+        bytecode_put_bytes(blob, writer.literals, writer.literal_count * sizeof(*writer.literals));
 
-        fxlc_put_comment_header(&blob, TAG_FXLC, sizeof(uint32_t) + writer.code.size);
-        put_u32(&blob, writer.instr_count);
-        bytecode_put_bytes(&blob, writer.code.data, writer.code.size);
+        fxlc_put_comment_header(blob, TAG_FXLC, sizeof(uint32_t) + writer.code.size);
+        put_u32(blob, writer.instr_count);
+        bytecode_put_bytes(blob, writer.code.data, writer.code.size);
 
-        put_u32(&blob, 0x0000ffff); /* End token. */
+        put_u32(blob, 0x0000ffff); /* End token. */
+
+        if (blob->status || writer.code.status)
+            set_status(fx, VKD3D_ERROR_OUT_OF_MEMORY);
+        else
+            ret = true;
+    }
+
+    fxlc_writer_cleanup(&writer);
+
+    return ret;
+}
+
+static uint32_t write_fx_2_expression_assignment(const struct hlsl_ir_var *var,
+        const struct hlsl_state_block_entry *entry, uint32_t *type, struct fx_write_context *fx)
+{
+    struct vkd3d_bytecode_buffer *unstructured = &fx->unstructured;
+    const struct hlsl_ir_node *value = entry->args->node;
+    struct vkd3d_bytecode_buffer blob = { 0 };
+    uint32_t offset;
+
+    if (entry->args_count != 1 || !hlsl_is_numeric_type(value->data_type))
+    {
+        hlsl_fixme(fx->ctx, &var->loc, "Unhandled expression for state %s.", entry->name);
+        return 0;
     }
 
     *type = write_fx_2_state_numeric_type(value->data_type, fx);
     offset = unstructured->size;
-    for (unsigned int i = 0; i < comp_count; ++i)
+    for (unsigned int i = 0; i < hlsl_type_component_count(value->data_type); ++i)
         put_u32(unstructured, 0);
 
-    if (blob.status || writer.code.status)
-        set_status(fx, VKD3D_ERROR_OUT_OF_MEMORY);
-    else if (!writer.failed)
+    if (write_fxlc_blob(var, entry->instrs, value, &blob, fx))
         write_fx_2_resource(FX_2_ASSIGNMENT_CODE_BLOB, blob.data, blob.size, fx);
-
     vkd3d_bytecode_buffer_cleanup(&blob);
-    fxlc_writer_cleanup(&writer);
+
+    return offset;
+}
+
+/* The index is computed by a fxlvm code blob, which follows the name of the
+ * array. */
+static uint32_t write_fx_2_array_selector_assignment(const struct hlsl_ir_var *var,
+        const struct hlsl_state_block_entry *entry, const struct hlsl_ir_index *index,
+        uint32_t *type, struct fx_write_context *fx)
+{
+    const struct hlsl_ir_var *array = hlsl_ir_load(index->val.node)->src.var;
+    struct vkd3d_bytecode_buffer data = { 0 };
+    size_t name_size = strlen(array->name) + 1;
+    static const uint32_t pad;
+    uint32_t offset;
+
+    if (!write_fx_2_reference_value(var, array->data_type->e.array.type, &offset, type, fx))
+        return 0;
+
+    /* The size of the name includes its padding. */
+    put_u32(&data, align(name_size, 4));
+    bytecode_put_bytes_unaligned(&data, array->name, name_size);
+    if (name_size % 4)
+        bytecode_put_bytes_unaligned(&data, &pad, 4 - (name_size % 4));
+
+    if (write_fxlc_blob(var, entry->instrs, index->idx.node, &data, fx))
+        write_fx_2_resource(FX_2_ASSIGNMENT_ARRAY_SELECTOR, data.data, data.size, fx);
+    vkd3d_bytecode_buffer_cleanup(&data);
 
     return offset;
 }
@@ -3595,11 +3646,17 @@ static void write_fx_2_state_assignment(const struct hlsl_ir_var *var,
             break;
         }
         case HLSL_IR_INDEX:
-            if (hlsl_is_numeric_type(value_node->data_type))
+        {
+            const struct hlsl_ir_node *val = hlsl_ir_index(value_node)->val.node;
+
+            /* Elements of parameter arrays are referenced by name, or
+             * selected with an array selector. */
+            if (hlsl_is_numeric_type(value_node->data_type) && val->data_type->class != HLSL_CLASS_ARRAY)
                 value = write_fx_2_expression_assignment(var, entry, &type, fx);
             else
-                value = write_fx_2_index_assignment(var, hlsl_ir_index(value_node), &type, fx);
+                value = write_fx_2_index_assignment(var, entry, &type, fx);
             break;
+        }
         case HLSL_IR_EXPR:
         case HLSL_IR_SWIZZLE:
             value = write_fx_2_expression_assignment(var, entry, &type, fx);
