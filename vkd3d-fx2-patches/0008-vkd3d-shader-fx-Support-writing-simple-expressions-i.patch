+[effect]
+float density;
+float4 factor;
+
+technique
+{
+    pass
+    {
+        FogDensity = density * 2.0;
+        FogStart = density / 4.0 + 1.0;
+        FogEnd = max(-density, 0.25);
+        LightDiffuse[0] = factor * 0.5;
+        LightPosition[0] = factor.zyx;
+    }
+}
