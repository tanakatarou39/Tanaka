 .../hlsl/effect-assignments-fx_2.shader_test  |  22 ++++
 2 files changed, 88 insertions(+), 39 deletions(-)

diff --git a/libs/vkd3d-shader/fx.c b/libs/vkd3d-shader/fx.c
index 5b429669..c36a61fd 100644
--- a/libs/vkd3d-shader/fx.c
+++ b/libs/vkd3d-shader/fx.c
@@ -316,6 +316,7 @@ struct fx_write_context
      * resources refer to their state assignments using it. */
     struct
     {
+        struct vkd3d_bytecode_buffer *buffer;
         uint32_t technique;
         uint32_t index;
         uint32_t element;
@@ -1121,6 +1122,7 @@ static void write_fx_2_pass(struct hlsl_ir_var *var, struct fx_write_context *fx
     count_offset = put_u32(buffer, 0);
 
     write_fx_2_annotations(var, annotation_count_offset, fx);
+    fx->fx_2_state.buffer = buffer;
     fx->fx_2_state.element = ~0u;
     fx->fx_2_state.state = 0;
     count = write_state_block(var, 0, fx);
@@ -1990,67 +1992,89 @@ static void write_fx_2_data_blob(struct vkd3d_bytecode_buffer *buffer, const voi
     }
 }
 
+static uint32_t write_fx_2_sampler_initializer(struct hlsl_ir_var *var, struct fx_write_context *fx)
+{
+    unsigned int i, elements_count = hlsl_get_multiarray_size(var->data_type);
+    struct vkd3d_bytecode_buffer buffer = { 0 };
+    uint32_t count_offset, count, offset;
+
+    /* State assignments of all elements have to be stored contiguously,
+     * while their types and values are written to the same unstructured
+     * buffer. Collect the assignments first, and append them afterwards. */
+    fx->fx_2_state.buffer = &buffer;
+    fx->fx_2_state.technique = ~0u;
+    fx->fx_2_state.index = fx->parameter_count;
+
+    for (i = 0; i < elements_count; ++i)
+    {
+        fx->fx_2_state.element = i;
+        fx->fx_2_state.state = 0;
+
+        count_offset = put_u32(&buffer, 0);
+        count = i < var->state_block_count ? write_state_block(var, i, fx) : 0;
+        set_u32(&buffer, count_offset, count);
+    }
+
+    set_status(fx, buffer.status);
+    offset = bytecode_put_bytes(&fx->unstructured, buffer.data, buffer.size);
+    vkd3d_bytecode_buffer_cleanup(&buffer);
+
+    return offset;
+}
