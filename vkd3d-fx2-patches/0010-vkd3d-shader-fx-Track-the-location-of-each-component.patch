+/* Returns the location of a copy of the components of a value which uses
+ * consecutive components of a single register. */
+static struct fxlc_operand fxlc_get_contiguous_operand(struct fxlc_writer *writer,
+        const struct fxlc_operand *components, unsigned int count)
+{
+    struct fxlc_operand tmp[4];
+    unsigned int i;
+
+    VKD3D_ASSERT(count <= ARRAY_SIZE(tmp));
+
+    for (i = 1; i < count; ++i)
+    {
+        if (!fxlc_operand_follows(&components[0], &components[i], i))
+            break;
+    }
+    if (i == count)
+        return components[0];
+
+    fxlc_allocate_temps(writer, tmp, count);
+    fxlc_write_componentwise(writer, FX_FXLC_OP_MOV, count, tmp, &components, 1);
+    return tmp[0];
 }
 
