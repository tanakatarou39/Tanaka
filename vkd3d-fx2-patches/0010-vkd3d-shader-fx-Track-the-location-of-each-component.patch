+/* An instruction operand covers consecutive components of a single register. */
+static bool fxlc_operand_follows(const struct fxlc_operand *first, const struct fxlc_operand *operand,
+        unsigned int count)
+{
+    return operand->table == first->table && operand->offset == first->offset + count
+            && operand->offset / 4 == first->offset / 4;
+}
+
+/* Writes an operation for each component, using as few instructions as the
+ * locations of the components allow. */
+static void fxlc_write_componentwise(struct fxlc_writer *writer, enum fxlc_opcode opcode, unsigned int comp_count,
+        const struct fxlc_operand *dst, const struct fxlc_operand *const *srcs, unsigned int src_count)
+{
+    struct fxlc_operand operands[3];
+    unsigned int i, j, count;
+
+    VKD3D_ASSERT(src_count <= ARRAY_SIZE(operands));
+
+    for (i = 0; i < comp_count; i += count)
+    {
+        for (count = 1; i + count < comp_count; ++count)
+        {
+            if (!fxlc_operand_follows(&dst[i], &dst[i + count], count))
+                break;
+            for (j = 0; j < src_count; ++j)
+            {
+                if (!fxlc_operand_follows(&srcs[j][i], &srcs[j][i + count], count))
+                    break;
+            }
+            if (j < src_count)
+                break;
+        }
+
+        for (j = 0; j < src_count; ++j)
+            operands[j] = srcs[j][i];
+        fxlc_write_instruction(writer, opcode, count, &dst[i], operands, src_count);
+    }
+}
