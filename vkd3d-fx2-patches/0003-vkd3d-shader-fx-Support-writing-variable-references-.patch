+{
+    pass
+    {
+        VertexShader = <vs>;
+        PixelShader = (ps);
+        Texture[0] = <tex>;
+        ViewTransform = <camera>;
+        AlphaBlendEnable = <enable>;
+        FillMode = <fill_mode>;
+    }
+    pass
+    {
+        VertexShader = vs_arr[1];
+    }
+}
