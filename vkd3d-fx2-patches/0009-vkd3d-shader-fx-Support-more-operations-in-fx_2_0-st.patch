From f8af3ace26dd157073109ae32f7f7bfafbb2996b Mon Sep 17 00:00:00 2001
From: chatgptyukkuri <chatgptyukkuri@gmail.com>
Date: Wed, 28 Oct 2026 03:35:56 +0000
Subject: [PATCH 9/9] vkd3d-shader/fx: Support more operations in fx_2_0 state
 expressions.

Comparison and logical operations produce 0.0 and 1.0 values, which allows
implementing the ternary operator with "cmp".

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01LkAyMz3ChWUcwV1bWoNa1Z
---
 libs/vkd3d-shader/fx.c                        | 114 +++++++++++++++++-
 .../hlsl/effect-assignments-fx_2.shader_test  |  19 +++
 2 files changed, 132 insertions(+), 1 deletion(-)

diff --git a/libs/vkd3d-shader/fx.c b/libs/vkd3d-shader/fx.c
index 96b5e457..46b33cfb 100644
--- a/libs/vkd3d-shader/fx.c
+++ b/libs/vkd3d-shader/fx.c
@@ -2404,10 +2404,20 @@ enum fxlc_opcode
     FX_FXLC_OP_MOV = 0x100,
     FX_FXLC_OP_NEG = 0x101,
     FX_FXLC_OP_RCP = 0x103,
+    FX_FXLC_OP_FRC = 0x104,
+    FX_FXLC_OP_EXP = 0x105,
+    FX_FXLC_OP_LOG = 0x106,
+    FX_FXLC_OP_RSQ = 0x107,
+    FX_FXLC_OP_SIN = 0x108,
+    FX_FXLC_OP_COS = 0x109,
     FX_FXLC_OP_MIN = 0x200,
     FX_FXLC_OP_MAX = 0x201,
+    FX_FXLC_OP_LT = 0x202,
+    FX_FXLC_OP_GE = 0x203,
     FX_FXLC_OP_ADD = 0x204,
     FX_FXLC_OP_MUL = 0x205,
+    FX_FXLC_OP_CMP = 0x300,
+    FX_FXLC_OP_DOT = 0x500,
 };
 
 struct fxlc_operand
@@ -2652,13 +2662,14 @@ static void fxlc_write_expr(struct fxlc_writer *writer, const struct hlsl_ir_exp
     unsigned int i, comp_count = expr->node.data_type->e.numeric.dimx;
     struct fxlc_operand args[3], srcs[3], dst, tmp;
     const struct hlsl_type *src_type;
+    static const double ones[4] = {1.0, 1.0, 1.0, 1.0};
 
     for (i = 0; i < ARRAY_SIZE(expr->operands) && expr->operands[i].node; ++i)
     {
         const struct hlsl_type *type = expr->operands[i].node->data_type;
 
         if (!hlsl_is_numeric_type(type) || type->class > HLSL_CLASS_VECTOR
-                || type->e.numeric.dimx != comp_count)
+                || (type->e.numeric.dimx != comp_count && expr->op != HLSL_OP2_DOT))
         {
             fxlc_fixme(writer, "Unhandled operand type for %s in a state expression.",
                     debug_hlsl_expr_op(expr->op));
@@ -2692,10 +2703,55 @@ static void fxlc_write_expr(struct fxlc_writer *writer, const struct hlsl_ir_exp
             fxlc_write_instruction(writer, FX_FXLC_OP_MOV, comp_count, &dst, args, 1);
             break;
 
+        case HLSL_OP1_ABS:
+            tmp = fxlc_allocate_temp(writer);
+            fxlc_write_instruction(writer, FX_FXLC_OP_NEG, comp_count, &tmp, args, 1);
+            srcs[0] = args[0];
+            srcs[1] = tmp;
+            fxlc_write_instruction(writer, FX_FXLC_OP_MAX, comp_count, &dst, srcs, 2);
+            break;
+
+        case HLSL_OP1_COS:
+            fxlc_write_instruction(writer, FX_FXLC_OP_COS, comp_count, &dst, args, 1);
+            break;
+
+        case HLSL_OP1_EXP2:
+            fxlc_write_instruction(writer, FX_FXLC_OP_EXP, comp_count, &dst, args, 1);
+            break;
+
+        case HLSL_OP1_FRACT:
+            fxlc_write_instruction(writer, FX_FXLC_OP_FRC, comp_count, &dst, args, 1);
+            break;
+
+        case HLSL_OP1_LOG2:
+            fxlc_write_instruction(writer, FX_FXLC_OP_LOG, comp_count, &dst, args, 1);
+            break;
+
+        case HLSL_OP1_LOGIC_NOT:
+            /* 1.0 - x */
+            tmp = fxlc_allocate_temp(writer);
+            fxlc_write_instruction(writer, FX_FXLC_OP_NEG, comp_count, &tmp, args, 1);
+            srcs[0] = tmp;
+            srcs[1] = fxlc_allocate_literals(writer, ones, comp_count);
+            fxlc_write_instruction(writer, FX_FXLC_OP_ADD, comp_count, &dst, srcs, 2);
+            break;
+
         case HLSL_OP1_NEG:
             fxlc_write_instruction(writer, FX_FXLC_OP_NEG, comp_count, &dst, args, 1);
             break;
 
+        case HLSL_OP1_RCP:
+            fxlc_write_instruction(writer, FX_FXLC_OP_RCP, comp_count, &dst, args, 1);
+            break;
+
+        case HLSL_OP1_RSQ:
+            fxlc_write_instruction(writer, FX_FXLC_OP_RSQ, comp_count, &dst, args, 1);
+            break;
+
+        case HLSL_OP1_SIN:
+            fxlc_write_instruction(writer, FX_FXLC_OP_SIN, comp_count, &dst, args, 1);
+            break;
+
         case HLSL_OP2_ADD:
             fxlc_write_instruction(writer, FX_FXLC_OP_ADD, comp_count, &dst, args, 2);
             break;
@@ -2714,6 +2770,39 @@ static void fxlc_write_expr(struct fxlc_writer *writer, const struct hlsl_ir_exp
             fxlc_write_instruction(writer, FX_FXLC_OP_MUL, comp_count, &dst, srcs, 2);
             break;
 
+        case HLSL_OP2_DOT:
+            fxlc_write_instruction(writer, FX_FXLC_OP_DOT, expr->operands[0].node->data_type->e.numeric.dimx,
+                    &dst, args, 2);
+            break;
+
+        case HLSL_OP2_EQUAL:
+            /* (a >= b) * (b >= a) */
+            tmp = fxlc_allocate_temp(writer);
+            fxlc_write_instruction(writer, FX_FXLC_OP_GE, comp_count, &tmp, args, 2);
+            srcs[0] = args[1];
+            srcs[1] = args[0];
+            fxlc_write_instruction(writer, FX_FXLC_OP_GE, comp_count, &dst, srcs, 2);
+            srcs[0] = dst;
+            srcs[1] = tmp;
+            fxlc_write_instruction(writer, FX_FXLC_OP_MUL, comp_count, &dst, srcs, 2);
+            break;
+
+        case HLSL_OP2_GEQUAL:
+            fxlc_write_instruction(writer, FX_FXLC_OP_GE, comp_count, &dst, args, 2);
+            break;
+
+        case HLSL_OP2_LESS:
+            fxlc_write_instruction(writer, FX_FXLC_OP_LT, comp_count, &dst, args, 2);
+            break;
+
+        case HLSL_OP2_LOGIC_AND:
+            fxlc_write_instruction(writer, FX_FXLC_OP_MUL, comp_count, &dst, args, 2);
+            break;
+
+        case HLSL_OP2_LOGIC_OR:
+            fxlc_write_instruction(writer, FX_FXLC_OP_MAX, comp_count, &dst, args, 2);
+            break;
+
         case HLSL_OP2_MAX:
             fxlc_write_instruction(writer, FX_FXLC_OP_MAX, comp_count, &dst, args, 2);
             break;
@@ -2726,6 +2815,29 @@ static void fxlc_write_expr(struct fxlc_writer *writer, const struct hlsl_ir_exp
             fxlc_write_instruction(writer, FX_FXLC_OP_MUL, comp_count, &dst, args, 2);
             break;
 
+        case HLSL_OP2_NEQUAL:
+            /* (a < b) + (b < a) */
+            tmp = fxlc_allocate_temp(writer);
+            fxlc_write_instruction(writer, FX_FXLC_OP_LT, comp_count, &tmp, args, 2);
+            srcs[0] = args[1];
+            srcs[1] = args[0];
+            fxlc_write_instruction(writer, FX_FXLC_OP_LT, comp_count, &dst, srcs, 2);
+            srcs[0] = dst;
+            srcs[1] = tmp;
+            fxlc_write_instruction(writer, FX_FXLC_OP_ADD, comp_count, &dst, srcs, 2);
+            break;
+
+        case HLSL_OP3_TERNARY:
+            /* The condition is either 0.0 or 1.0, "cmp" selects the second
+             * source if the first one is greater than or equal to zero. */
+            tmp = fxlc_allocate_temp(writer);
+            fxlc_write_instruction(writer, FX_FXLC_OP_NEG, comp_count, &tmp, args, 1);
+            srcs[0] = tmp;
+            srcs[1] = args[2];
+            srcs[2] = args[1];
+            fxlc_write_instruction(writer, FX_FXLC_OP_CMP, comp_count, &dst, srcs, 3);
+            break;
+
         default:
             fxlc_fixme(writer, "Unhandled operation %s in a state expression.", debug_hlsl_expr_op(expr->op));
             return;
diff --git a/tests/hlsl/effect-assignments-fx_2.shader_test b/tests/hlsl/effect-assignments-fx_2.shader_test
index bc16173b..a9334912 100644
--- a/tests/hlsl/effect-assignments-fx_2.shader_test
+++ b/tests/hlsl/effect-assignments-fx_2.shader_test
@@ -155,6 +155,25 @@ technique
         FogEnd = max(-density, 0.25);
         LightDiffuse[0] = factor * 0.5;
         LightPosition[0] = factor.zyx;
+        LightRange[0] = dot(factor, factor);
+    }
+}
+
+[effect]
+float density;
+bool enable;
+int mode;
+
+technique
+{
+    pass
+    {
+        AlphaBlendEnable = !enable;
+        ZEnable = (density > 0.5);
+        AlphaRef = enable ? 128 : 64;
+        TextureFactor = (mode == 2) ? 0xff : 0x10;
+        StencilEnable = enable && (mode != 1);
+        ZWriteEnable = enable || (density <= 0.0);
     }
 }
 
-- 
2.43.0

