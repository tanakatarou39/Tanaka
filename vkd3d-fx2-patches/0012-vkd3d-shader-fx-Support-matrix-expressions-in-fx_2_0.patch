+/* Allocates a literal for each component, the components of a register can
+ * be used for all the registers of the value. */
+static void fxlc_broadcast_literal(struct fxlc_writer *writer, double value,
+        struct fxlc_operand *components, unsigned int count)
+{
+    const double values[4] = {value, value, value, value};
+    struct fxlc_operand base;
+
+    base = fxlc_allocate_literals(writer, values, min(count, 4));
+    for (unsigned int i = 0; i < count; ++i)
+        components[i] = fxlc_offset_operand(&base, i % 4);
 }
 
