+/* Returns the components of the variable which a dereference covers, in the
+ * order of the components of the dereferenced value. The components of a
+ * matrix are numbered in row-major order, whatever the majority of the matrix
+ * is, but the path index of a column-major matrix selects a column. */
+static unsigned int *fxlc_get_deref_components(struct fxlc_writer *writer,
+        const struct hlsl_deref *deref, unsigned int *count)
+{
+    struct hlsl_type *type = deref->var->data_type;
+    struct hlsl_ctx *ctx = writer->fx->ctx;
+    unsigned int i, j, idx, size, *list;
+
+    size = hlsl_type_component_count(type);
+    if (!(list = hlsl_calloc(ctx, size, sizeof(*list))))
+    {
+        writer->failed = true;
+        return NULL;
+    }
+    for (i = 0; i < size; ++i)
+        list[i] = i;
+
+    for (i = 0; i < deref->path_len; ++i)
+    {
+        struct hlsl_ir_node *path_node = deref->path[i].node;
+        unsigned int offset = 0;
+
+        if (path_node->type != HLSL_IR_CONSTANT)
+        {
+            fxlc_fixme(writer, "Non-constant indices are not implemented in state expressions.");
+            vkd3d_free(list);
+            return NULL;
+        }
+        idx = hlsl_ir_constant(path_node)->value.u[0].u;
+
+        switch (type->class)
+        {
+            case HLSL_CLASS_VECTOR:
+                offset = idx;
+                size = 1;
+                break;
+
+            case HLSL_CLASS_MATRIX:
+                if (hlsl_type_is_row_major(type))
+                {
+                    offset = idx * type->e.numeric.dimx;
+                    size = type->e.numeric.dimx;
+                }
+                else
+                {
+                    for (j = 0; j < type->e.numeric.dimy; ++j)
+                        list[j] = list[j * type->e.numeric.dimx + idx];
+                    size = type->e.numeric.dimy;
+                }
+                break;
+
+            case HLSL_CLASS_ARRAY:
+                size = hlsl_type_component_count(type->e.array.type);
+                offset = idx * size;
+                break;
+
+            case HLSL_CLASS_STRUCT:
+                for (j = 0; j < idx; ++j)
+                    offset += hlsl_type_component_count(type->e.record.fields[j].type);
+                size = hlsl_type_component_count(type->e.record.fields[idx].type);
+                break;
+
+            default:
+                vkd3d_unreachable();
+        }
+        memmove(list, &list[offset], size * sizeof(*list));
+
+        type = hlsl_get_element_type_from_path_index(ctx, type, path_node);
+    }
+
+    *count = size;
+    return list;
+}
