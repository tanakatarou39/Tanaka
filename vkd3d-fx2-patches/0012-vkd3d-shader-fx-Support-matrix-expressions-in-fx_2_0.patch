+static void fxlc_write_index(struct fxlc_writer *writer, const struct hlsl_ir_index *index)
+{
+    const struct hlsl_ir_node *val = index->val.node, *idx = index->idx.node;
+    unsigned int i, element, comp_count = hlsl_type_component_count(index->node.data_type);
+    const struct fxlc_operand *src;
+    struct fxlc_operand *dst;
+
+    if (!hlsl_is_numeric_type(val->data_type) || val->data_type->class == HLSL_CLASS_SCALAR)
+    {
+        fxlc_fixme(writer, "Unhandled indexed value in a state expression.");
+        return;
+    }
+    if (idx->type != HLSL_IR_CONSTANT)
     {
-        memcpy(&dst[start], src, count * sizeof(*dst));
+        fxlc_fixme(writer, "Non-constant indices are not implemented in state expressions.");
+        return;
+    }
+
+    /* Vectors are indexed by component, and matrices by row. */
+    element = hlsl_ir_constant(idx)->value.u[0].u;
+    if (element >= val->data_type->e.numeric.dimy * val->data_type->e.numeric.dimx / comp_count)
+    {
+        hlsl_error(writer->fx->ctx, &index->node.loc, VKD3D_SHADER_ERROR_HLSL_OFFSET_OUT_OF_BOUNDS,
+                "Index %u is out of bounds.", element);
+        writer->failed = true;
+        return;
     }
+
+    if (!(src = fxlc_get_value(writer, val)) || !(dst = fxlc_add_value(writer, &index->node)))
+        return;
+    for (i = 0; i < comp_count; ++i)
+        dst[i] = src[element * comp_count + i];
 }
 
