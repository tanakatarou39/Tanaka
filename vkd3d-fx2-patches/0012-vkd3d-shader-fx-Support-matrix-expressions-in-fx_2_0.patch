 static struct fxlc_operand fxlc_get_input_component(const struct fxlc_input *input, unsigned int index)
 {
-    return (struct fxlc_operand){FX_FXLC_REG_CB, 4 * input->register_index + index};
+    const struct hlsl_type *type = input->var->data_type;
+    unsigned int row, column;
+
+    if (type->class != HLSL_CLASS_MATRIX)
+        return (struct fxlc_operand){FX_FXLC_REG_CB, 4 * input->register_index + index};
+
+    row = index / type->e.numeric.dimx;
+    column = index % type->e.numeric.dimx;
+    if (hlsl_type_is_row_major(type))
+        return (struct fxlc_operand){FX_FXLC_REG_CB, 4 * (input->register_index + row) + column};
+    return (struct fxlc_operand){FX_FXLC_REG_CB, 4 * (input->register_index + column) + row};
+}
