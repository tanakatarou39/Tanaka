From be2dc7099f84639c43867dfa4329ce28a1a9499c Mon Sep 17 00:00:00 2001
From: chatgptyukkuri <chatgptyukkuri@gmail.com>
Date: Thu, 29 Oct 2026 12:24:18 +0000
Subject: [PATCH 1/2] zink: only use the Vulkan memory model when the feature
 is supported

VK_KHR_vulkan_memory_model being exposed (or Vulkan 1.2 being supported)
does not mean that the vulkanMemoryModel feature is: the feature is
optional before Vulkan 1.3. Emitting the VulkanMemoryModel capability
without it produces SPIR-V the device cannot consume.

Query the feature struct and check it before enabling the memory model in
ntv. The ARM proprietary driver is one that exposes the extension without
reliably supporting the feature.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01LkAyMz3ChWUcwV1bWoNa1Z
---
 src/gallium/drivers/zink/zink_compiler.c     | 3 ++-
 src/gallium/drivers/zink/zink_device_info.py | 2 +-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/src/gallium/drivers/zink/zink_compiler.c b/src/gallium/drivers/zink/zink_compiler.c
index 8ff557a..6497579 100644
--- a/src/gallium/drivers/zink/zink_compiler.c
+++ b/src/gallium/drivers/zink/zink_compiler.c
@@ -1362,7 +1362,8 @@ zink_screen_init_compiler(struct zink_screen *screen)
                                                  BITFIELD_BIT(MESA_SHADER_FRAGMENT);
    screen->nir_options.support_indirect_outputs = (uint8_t)BITFIELD_MASK(MESA_SHADER_STAGES);
 
-   screen->ntv_info.have_vulkan_memory_model = screen->info.have_KHR_vulkan_memory_model;
+   screen->ntv_info.have_vulkan_memory_model = screen->info.have_KHR_vulkan_memory_model &&
+                                               screen->info.memory_model_feats.vulkanMemoryModel;
    screen->ntv_info.have_workgroup_memory_explicit_layout = screen->info.have_KHR_workgroup_memory_explicit_layout;
    screen->ntv_info.has_demote_to_helper = screen->info.have_EXT_shader_demote_to_helper_invocation;
    screen->ntv_info.broken_arbitary_type_const = screen->driver_compiler_workarounds.broken_const;
diff --git a/src/gallium/drivers/zink/zink_device_info.py b/src/gallium/drivers/zink/zink_device_info.py
index bc9e97c..39e497b 100644
--- a/src/gallium/drivers/zink/zink_device_info.py
+++ b/src/gallium/drivers/zink/zink_device_info.py
@@ -91,7 +91,7 @@ EXTENSIONS = [
     Extension("VK_KHR_unified_image_layouts", alias="unified_layouts", features=True),
     Extension("VK_KHR_external_memory"),
     Extension("VK_KHR_external_memory_fd"),
-    Extension("VK_KHR_vulkan_memory_model"),
+    Extension("VK_KHR_vulkan_memory_model", alias="memory_model", features=True),
     Extension("VK_KHR_workgroup_memory_explicit_layout", alias="explicit_layout", features=True),
     Extension("VK_KHR_pipeline_executable_properties",
               alias="pipestats",
