+struct composition_visual *unsafe_impl_from_IDCompositionVisual(IDCompositionVisual *iface)
+{
+    if (!iface || iface->lpVtbl != (IDCompositionVisualVtbl *)&visual_vtbl)
+        return NULL;
+    return CONTAINING_RECORD(iface, struct composition_visual, IDCompositionVisual3_iface);
+}
+
+HRESULT create_visual(struct composition_device *device, struct composition_visual **out)
+{
+    struct composition_visual *visual;
+
+    if (!(visual = calloc(1, sizeof(*visual))))
+        return E_OUTOFMEMORY;
+    visual->IDCompositionVisual3_iface.lpVtbl = &visual_vtbl;
+    visual->refcount = 1;
+    visual->device = device;
+    IDCompositionDevice_AddRef(&device->IDCompositionDevice_iface);
+    list_init(&visual->children);
+    visual->visible = TRUE;
+
+    TRACE("Created visual %p.\n", visual);
+    *out = visual;
+    return S_OK;
+}
