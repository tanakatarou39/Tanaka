+static HRESULT device_get_frame_statistics(DCOMPOSITION_FRAME_STATISTICS *statistics)
+{
+    LARGE_INTEGER now, frequency;
+    LONGLONG period;
+
+    if (!statistics)
+        return E_INVALIDARG;
+
+    QueryPerformanceCounter(&now);
+    QueryPerformanceFrequency(&frequency);
+    period = frequency.QuadPart / 60;
+
+    statistics->lastFrameTime.QuadPart = now.QuadPart - now.QuadPart % period;
+    statistics->currentCompositionRate.Numerator = 60;
+    statistics->currentCompositionRate.Denominator = 1;
+    statistics->currentTime = now;
+    statistics->timeFrequency = frequency;
+    statistics->nextEstimatedFrameTime.QuadPart = statistics->lastFrameTime.QuadPart + period;
+    return S_OK;
+}
+
+static HRESULT device_create_visual(struct composition_device *device, void **out)
+{
