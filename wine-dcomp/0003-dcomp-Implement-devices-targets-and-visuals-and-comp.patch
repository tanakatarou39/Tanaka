+    IDXGISwapChain1 *swapchain;
+    HRESULT hr;
+
+    TRACE("iface %p, content %p.\n", iface, content);
+
+    if (content)
+    {
+        if (SUCCEEDED(IUnknown_QueryInterface(content, &IID_IDXGISwapChain1, (void **)&swapchain)))
+        {
+            hr = get_swapchain_image(swapchain, &image);
+            IDXGISwapChain1_Release(swapchain);
+            if (FAILED(hr))
+                return hr;
+        }
+        else
+        {
+            FIXME("Unsupported content %p.\n", content);
+        }
+        IUnknown_AddRef(content);
+    }
+
+    EnterCriticalSection(&dcomp_cs);
+    visual_set_content(visual, content, image);
+    LeaveCriticalSection(&dcomp_cs);
+    return S_OK;
+}
