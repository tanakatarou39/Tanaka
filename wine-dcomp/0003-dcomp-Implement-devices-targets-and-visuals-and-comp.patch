+static HRESULT STDMETHODCALLTYPE visual_SetTransform3D(IDCompositionVisual3 *iface, const D2D_MATRIX_4X4_F *matrix)
+{
+    D2D_MATRIX_3X2_F matrix_2d;
+
+    TRACE("iface %p, matrix %p.\n", iface, matrix);
+
+    if (!matrix)
+        return E_INVALIDARG;
+
+    if (matrix->_13 || matrix->_14 || matrix->_23 || matrix->_24 || matrix->_31 || matrix->_32
+            || matrix->_34 || matrix->_43 || matrix->_33 != 1.0f || matrix->_44 != 1.0f)
+        FIXME("Ignoring the 3D part of the transform.\n");
+
+    matrix_2d._11 = matrix->_11;
+    matrix_2d._12 = matrix->_12;
+    matrix_2d._21 = matrix->_21;
+    matrix_2d._22 = matrix->_22;
+    matrix_2d._31 = matrix->_41;
+    matrix_2d._32 = matrix->_42;
+    return visual_SetTransform(iface, &matrix_2d);
+}
