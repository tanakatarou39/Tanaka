+static HRESULT STDMETHODCALLTYPE visual_AddVisual(IDCompositionVisual3 *iface, IDCompositionVisual *child_iface,
+        BOOL insert_above, IDCompositionVisual *reference_iface)
+{
+    struct composition_visual *visual = impl_from_IDCompositionVisual3(iface);
+    struct composition_visual *child, *reference = NULL, *ancestor;
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, visual %p, insert_above %d, reference %p.\n", iface, child_iface, insert_above, reference_iface);
+
+    if (!(child = unsafe_impl_from_IDCompositionVisual(child_iface)))
+        return E_INVALIDARG;
+    if (reference_iface && !(reference = unsafe_impl_from_IDCompositionVisual(reference_iface)))
+        return E_INVALIDARG;
+
+    EnterCriticalSection(&dcomp_cs);
+
+    if (child->parent || child->target || child->device != visual->device
+            || (reference && reference->parent != visual))
+    {
+        hr = E_INVALIDARG;
+        goto done;
+    }
+    for (ancestor = visual; ancestor; ancestor = ancestor->parent)
+    {
+        if (ancestor == child)
+        {
+            hr = E_INVALIDARG;
+            goto done;
+        }
+    }
+
+    /* The children are kept back to front. Without a reference visual,
+     * insert_above places the child below all of its siblings. */
+    if (reference)
+    {
+        if (insert_above)
+            list_add_after(&reference->entry, &child->entry);
+        else
+            list_add_before(&reference->entry, &child->entry);
+    }
+    else
+    {
+        if (insert_above)
+            list_add_head(&visual->children, &child->entry);
+        else
+            list_add_tail(&visual->children, &child->entry);
+    }
+    child->parent = visual;
+    IDCompositionVisual3_AddRef(&child->IDCompositionVisual3_iface);
+
+done:
+    LeaveCriticalSection(&dcomp_cs);
+    return hr;
+}
+
+static HRESULT STDMETHODCALLTYPE visual_RemoveVisual(IDCompositionVisual3 *iface, IDCompositionVisual *child_iface)
+{
+    struct composition_visual *visual = impl_from_IDCompositionVisual3(iface);
+    struct composition_visual *child;
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, visual %p.\n", iface, child_iface);
+
+    if (!(child = unsafe_impl_from_IDCompositionVisual(child_iface)))
+        return E_INVALIDARG;
+
+    EnterCriticalSection(&dcomp_cs);
+    if (child->parent == visual)
+        visual_detach(child);
+    else
+        hr = E_INVALIDARG;
+    LeaveCriticalSection(&dcomp_cs);
+    return hr;
+}
+
+static HRESULT STDMETHODCALLTYPE visual_RemoveAllVisuals(IDCompositionVisual3 *iface)
+{
+    struct composition_visual *visual = impl_from_IDCompositionVisual3(iface);
+    struct composition_visual *child, *next;
+
+    TRACE("iface %p.\n", iface);
+
+    EnterCriticalSection(&dcomp_cs);
+    LIST_FOR_EACH_ENTRY_SAFE(child, next, &visual->children, struct composition_visual, entry)
+        visual_detach(child);
+    LeaveCriticalSection(&dcomp_cs);
+    return S_OK;
+}
