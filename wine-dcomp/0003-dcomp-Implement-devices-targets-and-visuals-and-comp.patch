+#ifndef __WINE_DCOMP_PRIVATE_H
+#define __WINE_DCOMP_PRIVATE_H
+
+#include <stdarg.h>
+#include <stdbool.h>
+
+#define COBJMACROS
+#include "windef.h"
+#include "winbase.h"
+#include "wingdi.h"
+#include "winuser.h"
+#ifdef DCOMP_INIT_GUID
+#include "initguid.h"
+#endif
+#include "d3d11.h"
+#include "dcomp.h"
+
+struct wined3d_resource;
+struct wined3d_texture;
+#include "wine/winedxgi.h"
+#include "wine/list.h"
+
+/* Protects the visual trees, the targets and the swapchain images. */
+extern CRITICAL_SECTION dcomp_cs;
+extern struct list dcomp_targets;
+
+struct composition_device
+{
+    IDCompositionDevice IDCompositionDevice_iface;
+    IDCompositionDesktopDevice IDCompositionDesktopDevice_iface;
+    IDCompositionDevice3 IDCompositionDevice3_iface;
+    LONG refcount;
+    unsigned int version;
+};
+
+struct composition_target
+{
+    IDCompositionTarget IDCompositionTarget_iface;
+    LONG refcount;
+    struct composition_device *device;
+    struct composition_visual *root;
+    HWND hwnd;
+    BOOL topmost;
+    bool committed;
+    struct list entry;
+};
+
+/* The last image presented to a composition swapchain. */
+struct composition_swapchain_image
+{
+    IWineDXGICompositionCallback IWineDXGICompositionCallback_iface;
+    LONG refcount;
+    ID3D11Texture2D *staging;
+    DWORD *bits;
+    unsigned int width, height;
+    DXGI_ALPHA_MODE alpha_mode;
+    bool opaque;
+    bool valid;
+};
+
+struct composition_rectangle_clip
+{
+    IDCompositionRectangleClip IDCompositionRectangleClip_iface;
+    LONG refcount;
+    D2D_RECT_F rect;
+};
+
+struct composition_visual
+{
+    IDCompositionVisual3 IDCompositionVisual3_iface;
+    LONG refcount;
+    struct composition_device *device;
+
+    struct composition_visual *parent;
+    struct composition_target *target;
+    struct list entry;
+    struct list children;
+
+    IUnknown *content;
+    struct composition_swapchain_image *image;
+
+    float offset_x, offset_y;
+    D2D_MATRIX_3X2_F transform;
+    bool has_transform;
+    D2D_RECT_F clip;
+    bool has_clip;
+    struct composition_rectangle_clip *clip_object;
+    BOOL visible;
+};
+
+static inline struct composition_device *impl_from_IDCompositionDevice(IDCompositionDevice *iface)
+{
+    return CONTAINING_RECORD(iface, struct composition_device, IDCompositionDevice_iface);
+}
+
+HRESULT create_visual(struct composition_device *device, struct composition_visual **visual);
+HRESULT create_rectangle_clip(IDCompositionRectangleClip **clip);
+struct composition_visual *unsafe_impl_from_IDCompositionVisual(IDCompositionVisual *iface);
+void visual_detach(struct composition_visual *visual);
+
+HRESULT get_swapchain_image(IDXGISwapChain1 *swapchain, struct composition_swapchain_image **image);
+void compose_target(struct composition_target *target);
+
+#endif /* __WINE_DCOMP_PRIVATE_H */
diff --git a/dlls/dcomp/device.c b/dlls/dcomp/device.c
