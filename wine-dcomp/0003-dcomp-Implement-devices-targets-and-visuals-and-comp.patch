+static HRESULT create_target(struct composition_device *device, HWND hwnd, BOOL topmost,
+        IDCompositionTarget **out)
+{
+    struct composition_target *target;
+    DWORD pid;
+
+    if (!out)
+        return E_INVALIDARG;
+    *out = NULL;
+
+    if (!IsWindow(hwnd))
+        return E_INVALIDARG;
+    GetWindowThreadProcessId(hwnd, &pid);
+    if (pid != GetCurrentProcessId())
+    {
+        WARN("Window %p belongs to another process.\n", hwnd);
+        return E_ACCESSDENIED;
+    }
+
+    if (!(target = calloc(1, sizeof(*target))))
+        return E_OUTOFMEMORY;
+    target->IDCompositionTarget_iface.lpVtbl = &target_vtbl;
+    target->refcount = 1;
+    target->hwnd = hwnd;
+    target->topmost = topmost;
+    target->device = device;
+
+    EnterCriticalSection(&dcomp_cs);
+    {
+        struct composition_target *other;
+
+        LIST_FOR_EACH_ENTRY(other, &dcomp_targets, struct composition_target, entry)
+        {
+            if (other->hwnd == hwnd && other->topmost == topmost)
+            {
+                LeaveCriticalSection(&dcomp_cs);
+                free(target);
+                return DCOMPOSITION_ERROR_WINDOW_ALREADY_COMPOSED;
+            }
+        }
+    }
+    list_add_tail(&dcomp_targets, &target->entry);
+    IDCompositionDevice_AddRef(&device->IDCompositionDevice_iface);
+    LeaveCriticalSection(&dcomp_cs);
+
+    TRACE("Created target %p for window %p.\n", target, hwnd);
+    *out = &target->IDCompositionTarget_iface;
+    return S_OK;
+}
+
+static HRESULT device_commit(struct composition_device *device)
+{
+    struct composition_target *target;
+
+    EnterCriticalSection(&dcomp_cs);
+    LIST_FOR_EACH_ENTRY(target, &dcomp_targets, struct composition_target, entry)
+    {
+        if (target->device != device)
+            continue;
+        target->committed = true;
+        compose_target(target);
+    }
+    LeaveCriticalSection(&dcomp_cs);
+
+    return S_OK;
+}
