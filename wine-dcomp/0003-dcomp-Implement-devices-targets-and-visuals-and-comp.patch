+#include <math.h>
+
+#include "dcomp_private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(dcomp);
+
+static inline struct composition_swapchain_image *impl_from_IWineDXGICompositionCallback(
+        IWineDXGICompositionCallback *iface)
+{
+    return CONTAINING_RECORD(iface, struct composition_swapchain_image, IWineDXGICompositionCallback_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE swapchain_image_QueryInterface(IWineDXGICompositionCallback *iface,
+        REFIID iid, void **out)
+{
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IWineDXGICompositionCallback) || IsEqualGUID(iid, &IID_IUnknown))
+    {
+        IWineDXGICompositionCallback_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+
+    WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE swapchain_image_AddRef(IWineDXGICompositionCallback *iface)
+{
+    struct composition_swapchain_image *image = impl_from_IWineDXGICompositionCallback(iface);
+    ULONG refcount = InterlockedIncrement(&image->refcount);
+
+    TRACE("%p increasing refcount to %lu.\n", iface, refcount);
+
+    return refcount;
+}
+
+static ULONG STDMETHODCALLTYPE swapchain_image_Release(IWineDXGICompositionCallback *iface)
+{
+    struct composition_swapchain_image *image = impl_from_IWineDXGICompositionCallback(iface);
+    ULONG refcount = InterlockedDecrement(&image->refcount);
+
+    TRACE("%p decreasing refcount to %lu.\n", iface, refcount);
+
+    if (!refcount)
+    {
+        if (image->staging)
+            ID3D11Texture2D_Release(image->staging);
+        free(image->bits);
+        free(image);
+    }
+
+    return refcount;
+}
+
+static bool format_is_bgra(DXGI_FORMAT format, bool *opaque)
+{
+    switch (format)
+    {
+        case DXGI_FORMAT_B8G8R8X8_UNORM:
+        case DXGI_FORMAT_B8G8R8X8_UNORM_SRGB:
+            *opaque = true;
+            /* fall through */
+        case DXGI_FORMAT_B8G8R8A8_UNORM:
+        case DXGI_FORMAT_B8G8R8A8_UNORM_SRGB:
+            return true;
+        default:
+            return false;
+    }
+}
+
+static bool format_is_rgba(DXGI_FORMAT format)
+{
+    return format == DXGI_FORMAT_R8G8B8A8_UNORM || format == DXGI_FORMAT_R8G8B8A8_UNORM_SRGB;
+}
+
+/* Called with dcomp_cs held. Copies buffer 0 of the swapchain to memory. */
+static void swapchain_image_update(struct composition_swapchain_image *image, IDXGISwapChain1 *swapchain)
+{
+    D3D11_TEXTURE2D_DESC desc, staging_desc;
+    D3D11_MAPPED_SUBRESOURCE map;
+    ID3D11DeviceContext *context;
+    ID3D11Texture2D *buffer;
+    ID3D11Device *device;
+    bool bgra, opaque;
+    unsigned int x, y;
+    HRESULT hr;
+
+    if (FAILED(hr = IDXGISwapChain1_GetBuffer(swapchain, 0, &IID_ID3D11Texture2D, (void **)&buffer)))
+    {
+        WARN("Failed to get buffer 0, hr %#lx.\n", hr);
+        return;
+    }
+    ID3D11Texture2D_GetDesc(buffer, &desc);
+
+    opaque = image->alpha_mode == DXGI_ALPHA_MODE_IGNORE || image->alpha_mode == DXGI_ALPHA_MODE_UNSPECIFIED;
+    if (!(bgra = format_is_bgra(desc.Format, &opaque)) && !format_is_rgba(desc.Format))
+    {
+        FIXME("Unsupported swapchain format %#x.\n", desc.Format);
+        ID3D11Texture2D_Release(buffer);
+        return;
+    }
+
+    if (image->staging)
+    {
+        ID3D11Texture2D_GetDesc(image->staging, &staging_desc);
+        if (staging_desc.Width != desc.Width || staging_desc.Height != desc.Height
+                || staging_desc.Format != desc.Format)
+        {
+            ID3D11Texture2D_Release(image->staging);
+            image->staging = NULL;
+        }
+    }
+
+    ID3D11Texture2D_GetDevice(buffer, &device);
+    if (!image->staging)
+    {
+        staging_desc = desc;
+        staging_desc.MipLevels = 1;
+        staging_desc.ArraySize = 1;
+        staging_desc.SampleDesc.Count = 1;
+        staging_desc.SampleDesc.Quality = 0;
+        staging_desc.Usage = D3D11_USAGE_STAGING;
+        staging_desc.BindFlags = 0;
+        staging_desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+        staging_desc.MiscFlags = 0;
+        if (FAILED(hr = ID3D11Device_CreateTexture2D(device, &staging_desc, NULL, &image->staging)))
+        {
+            ERR("Failed to create a staging texture, hr %#lx.\n", hr);
+            goto done;
+        }
+    }
+
+    if (image->width != desc.Width || image->height != desc.Height)
+    {
+        free(image->bits);
+        image->valid = false;
+        image->width = image->height = 0;
+        if (!(image->bits = malloc(desc.Width * desc.Height * sizeof(*image->bits))))
+            goto done;
+        image->width = desc.Width;
+        image->height = desc.Height;
+    }
+
+    ID3D11Device_GetImmediateContext(device, &context);
+    ID3D11DeviceContext_CopySubresourceRegion(context, (ID3D11Resource *)image->staging, 0, 0, 0, 0,
+            (ID3D11Resource *)buffer, 0, NULL);
+    if (SUCCEEDED(hr = ID3D11DeviceContext_Map(context, (ID3D11Resource *)image->staging, 0,
+            D3D11_MAP_READ, 0, &map)))
+    {
+        for (y = 0; y < image->height; ++y)
+        {
+            const DWORD *src = (const DWORD *)((const BYTE *)map.pData + y * map.RowPitch);
+            DWORD *dst = image->bits + y * image->width;
+
+            if (bgra)
+                memcpy(dst, src, image->width * sizeof(*dst));
+            else
+                for (x = 0; x < image->width; ++x)
+                    dst[x] = (src[x] & 0xff00ff00) | ((src[x] & 0xff) << 16) | ((src[x] >> 16) & 0xff);
+            if (opaque)
+                for (x = 0; x < image->width; ++x)
+                    dst[x] |= 0xff000000;
+        }
+        ID3D11DeviceContext_Unmap(context, (ID3D11Resource *)image->staging, 0);
+        image->opaque = opaque;
+        image->valid = true;
+    }
+    else
+    {
+        ERR("Failed to map the staging texture, hr %#lx.\n", hr);
+    }
+    ID3D11DeviceContext_Release(context);
+
+done:
+    ID3D11Device_Release(device);
+    ID3D11Texture2D_Release(buffer);
+}
+
+static bool visual_uses_image(const struct composition_visual *visual,
+        const struct composition_swapchain_image *image)
+{
+    const struct composition_visual *child;
+
+    if (visual->image == image)
+        return true;
+    LIST_FOR_EACH_ENTRY(child, &visual->children, struct composition_visual, entry)
+    {
+        if (visual_uses_image(child, image))
+            return true;
+    }
+    return false;
+}
+
+static void STDMETHODCALLTYPE swapchain_image_present(IWineDXGICompositionCallback *iface,
+        IDXGISwapChain1 *swapchain)
+{
+    struct composition_swapchain_image *image = impl_from_IWineDXGICompositionCallback(iface);
+    struct composition_target *target;
+
+    TRACE("iface %p, swapchain %p.\n", iface, swapchain);
+
+    EnterCriticalSection(&dcomp_cs);
+    swapchain_image_update(image, swapchain);
+    LIST_FOR_EACH_ENTRY(target, &dcomp_targets, struct composition_target, entry)
+    {
+        if (target->committed && target->root && visual_uses_image(target->root, image))
+            compose_target(target);
+    }
+    LeaveCriticalSection(&dcomp_cs);
+}
+
+static const struct IWineDXGICompositionCallbackVtbl swapchain_image_vtbl =
+{
+    swapchain_image_QueryInterface,
+    swapchain_image_AddRef,
+    swapchain_image_Release,
+    swapchain_image_present,
+};
+
+/* Returns the image attached to the swapchain, attaching a new one if needed. */
+HRESULT get_swapchain_image(IDXGISwapChain1 *swapchain, struct composition_swapchain_image **out)
+{
+    IWineDXGICompositionCallback *callback;
+    struct composition_swapchain_image *image;
+    UINT size = sizeof(callback);
+    DXGI_SWAP_CHAIN_DESC1 desc;
+    HRESULT hr;
+
+    EnterCriticalSection(&dcomp_cs);
+
+    if (SUCCEEDED(IDXGISwapChain1_GetPrivateData(swapchain, &IID_IWineDXGICompositionCallback, &size, &callback)))
+    {
+        if (callback->lpVtbl != &swapchain_image_vtbl)
+        {
+            WARN("Swapchain %p has a foreign composition callback.\n", swapchain);
+            IWineDXGICompositionCallback_Release(callback);
+            hr = E_INVALIDARG;
+            goto done;
+        }
+        *out = impl_from_IWineDXGICompositionCallback(callback);
+        hr = S_OK;
+        goto done;
+    }
+
+    if (!(image = calloc(1, sizeof(*image))))
+    {
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    image->IWineDXGICompositionCallback_iface.lpVtbl = &swapchain_image_vtbl;
+    image->refcount = 1;
+    IDXGISwapChain1_GetDesc1(swapchain, &desc);
+    if ((image->alpha_mode = desc.AlphaMode) == DXGI_ALPHA_MODE_STRAIGHT)
+        FIXME("Straight alpha is not supported.\n");
+
+    if (FAILED(hr = IDXGISwapChain1_SetPrivateDataInterface(swapchain, &IID_IWineDXGICompositionCallback,
+            (IUnknown *)&image->IWineDXGICompositionCallback_iface)))
+    {
+        WARN("Failed to attach to swapchain %p, hr %#lx.\n", swapchain, hr);
+        free(image);
+        goto done;
+    }
+
+    /* The swapchain may already have presented. */
+    swapchain_image_update(image, swapchain);
+    *out = image;
+
+done:
+    LeaveCriticalSection(&dcomp_cs);
+    return hr;
+}
+
+struct compose_context
+{
+    DWORD *bits;
+    int width, height;
+};
+
+static int clamp_coordinate(float f)
+{
+    if (f < -(float)(1 << 24))
+        return -(1 << 24);
+    if (f > (float)(1 << 24))
+        return 1 << 24;
+    return lroundf(f);
+}
+
+static void blend_image(const struct compose_context *ctx, const struct composition_swapchain_image *image,
+        int x, int y, const RECT *clip)
+{
+    RECT rect = {x, y, x + image->width, y + image->height};
+    int i, j;
+
+    if (!IntersectRect(&rect, &rect, clip))
+        return;
+
+    for (j = rect.top; j < rect.bottom; ++j)
+    {
+        const DWORD *src = image->bits + (j - y) * image->width + (rect.left - x);
+        DWORD *dst = ctx->bits + j * ctx->width + rect.left;
+
+        if (image->opaque)
+        {
+            memcpy(dst, src, (rect.right - rect.left) * sizeof(*dst));
+            continue;
+        }
+
+        for (i = 0; i < rect.right - rect.left; ++i)
+        {
+            unsigned int inv_alpha = 255 - (src[i] >> 24), c, result = 0;
+
+            for (c = 0; c < 32; c += 8)
+            {
+                unsigned int s = (src[i] >> c) & 0xff, d = (dst[i] >> c) & 0xff;
+                result |= min(255, s + (d * inv_alpha + 127) / 255) << c;
+            }
+            dst[i] = result;
+        }
+    }
+}
+
+static void compose_visual(const struct compose_context *ctx, const struct composition_visual *visual,
+        float x, float y, const RECT *parent_clip)
+{
+    const struct composition_visual *child;
+    const D2D_RECT_F *local_clip = NULL;
+    RECT clip = *parent_clip, rect;
+
+    if (!visual->visible)
+        return;
+
+    x += visual->offset_x;
+    y += visual->offset_y;
+    if (visual->has_transform)
+    {
+        const D2D_MATRIX_3X2_F *m = &visual->transform;
+
+        if (m->_11 != 1.0f || m->_12 != 0.0f || m->_21 != 0.0f || m->_22 != 1.0f)
+            FIXME("Only translations are implemented, ignoring {%.8e, %.8e, %.8e, %.8e}.\n",
+                    m->_11, m->_12, m->_21, m->_22);
+        x += m->_31;
+        y += m->_32;
+    }
+
+    if (visual->has_clip)
+        local_clip = &visual->clip;
+    else if (visual->clip_object)
+        local_clip = &visual->clip_object->rect;
+    if (local_clip)
+    {
+        rect.left = clamp_coordinate(x + local_clip->left);
+        rect.top = clamp_coordinate(y + local_clip->top);
+        rect.right = clamp_coordinate(x + local_clip->right);
+        rect.bottom = clamp_coordinate(y + local_clip->bottom);
+        if (!IntersectRect(&clip, &clip, &rect))
+            return;
+    }
+
+    if (visual->image && visual->image->valid)
+        blend_image(ctx, visual->image, clamp_coordinate(x), clamp_coordinate(y), &clip);
+
+    LIST_FOR_EACH_ENTRY(child, &visual->children, struct composition_visual, entry)
+        compose_visual(ctx, child, x, y, &clip);
+}
+
+static void present_to_window(const struct composition_target *target, HDC src_dc, int width, int height)
+{
+    BLENDFUNCTION blend = {AC_SRC_OVER, 0, 255, AC_SRC_ALPHA};
+    LONG style = GetWindowLongW(target->hwnd, GWL_STYLE);
+    LONG ex_style = GetWindowLongW(target->hwnd, GWL_EXSTYLE);
+    HDC dst_dc;
+
+    /* A top-level layered window that isn't driven by
+     * SetLayeredWindowAttributes() only shows what UpdateLayeredWindow()
+     * gives it. */
+    if ((ex_style & WS_EX_LAYERED) && !(style & WS_CHILD)
+            && !GetLayeredWindowAttributes(target->hwnd, NULL, NULL, NULL))
+    {
+        POINT src = {0, 0};
+
+        /* Don't resize the window; that would send messages while dcomp_cs is held. */
+        if (!UpdateLayeredWindow(target->hwnd, NULL, NULL, NULL, src_dc, &src, 0, &blend, ULW_ALPHA))
+            WARN("Failed to update layered window %p, error %lu.\n", target->hwnd, GetLastError());
+        return;
+    }
+
+    dst_dc = GetDCEx(target->hwnd, 0, DCX_CACHE | (target->topmost ? 0 : DCX_CLIPCHILDREN));
+    GdiAlphaBlend(dst_dc, 0, 0, width, height, src_dc, 0, 0, width, height, blend);
+    ReleaseDC(target->hwnd, dst_dc);
+}
+
+/* Called with dcomp_cs held. */
+void compose_target(struct composition_target *target)
+{
+    BITMAPINFO info = {{sizeof(BITMAPINFOHEADER)}};
+    struct compose_context ctx;
+    HBITMAP bitmap;
+    RECT client;
+    HDC dc;
+
+    TRACE("target %p, window %p.\n", target, target->hwnd);
+
+    if (!IsWindowVisible(target->hwnd) || !GetClientRect(target->hwnd, &client))
+        return;
+    if (!(ctx.width = client.right) || !(ctx.height = client.bottom))
+        return;
+
+    info.bmiHeader.biWidth = ctx.width;
+    info.bmiHeader.biHeight = -ctx.height;
+    info.bmiHeader.biPlanes = 1;
+    info.bmiHeader.biBitCount = 32;
+    info.bmiHeader.biCompression = BI_RGB;
+    if (!(bitmap = CreateDIBSection(NULL, &info, DIB_RGB_COLORS, (void **)&ctx.bits, NULL, 0)))
+    {
+        ERR("Failed to create a %dx%d bitmap.\n", ctx.width, ctx.height);
+        return;
+    }
+    memset(ctx.bits, 0, ctx.width * ctx.height * sizeof(*ctx.bits));
+
+    if (target->root)
+        compose_visual(&ctx, target->root, 0.0f, 0.0f, &client);
+
+    dc = CreateCompatibleDC(NULL);
+    SelectObject(dc, bitmap);
+    present_to_window(target, dc, ctx.width, ctx.height);
+    DeleteDC(dc);
+    DeleteObject(bitmap);
+}
