+/* Called with dcomp_cs held. Removes the visual from its parent and drops the
+ * parent's reference. */
+void visual_detach(struct composition_visual *visual)
+{
+    list_remove(&visual->entry);
+    visual->parent = NULL;
+    IDCompositionVisual3_Release(&visual->IDCompositionVisual3_iface);
+}
