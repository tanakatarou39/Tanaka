+    HRESULT hr;
+
+    if (!out)
+        return E_INVALIDARG;
+    *out = NULL;
+
+    if (FAILED(hr = create_visual(device, &visual)))
+        return hr;
+    *out = &visual->IDCompositionVisual3_iface;
+    return S_OK;
+}
