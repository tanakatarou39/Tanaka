+static HRESULT create_device(unsigned int version, IUnknown *rendering_device, REFIID iid, void **out)
+{
+    struct composition_device *device;
+    IUnknown *iface;
+    HRESULT hr;
+
+    if (!out)
+        return E_INVALIDARG;
+    *out = NULL;
+
+    /* Only swapchains are supported as content, and they don't need the
+     * rendering device. */
+    if (rendering_device)
+        TRACE("Ignoring rendering device %p.\n", rendering_device);
+
+    if (!(device = calloc(1, sizeof(*device))))
+        return E_OUTOFMEMORY;
+    device->IDCompositionDevice_iface.lpVtbl = &device_vtbl;
+    device->IDCompositionDesktopDevice_iface.lpVtbl = &desktop_device_vtbl;
+    device->IDCompositionDevice3_iface.lpVtbl = &device3_vtbl;
+    device->refcount = 1;
+    device->version = version;
+
+    if (version == 1)
+        iface = (IUnknown *)&device->IDCompositionDevice_iface;
+    else
+        iface = (IUnknown *)&device->IDCompositionDesktopDevice_iface;
+
+    hr = IUnknown_QueryInterface(iface, iid, out);
+    IUnknown_Release(iface);
+    return hr;
+}
+
+HRESULT WINAPI DCompositionCreateDevice(IDXGIDevice *dxgi_device, REFIID iid, void **device)
+{
+    TRACE("%p, %s, %p.\n", dxgi_device, debugstr_guid(iid), device);
+
+    return create_device(1, (IUnknown *)dxgi_device, iid, device);
+}
