+            IDCompositionRectangleClip_Release(&visual->clip_object->IDCompositionRectangleClip_iface);
+        IDCompositionDevice_Release(&visual->device->IDCompositionDevice_iface);
+        free(visual);
+    }
+
+    return refcount;
+}
