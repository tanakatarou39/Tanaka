From 9510fff4c9f02aa832d8afb2910bfb8b13d41d45 Mon Sep 17 00:00:00 2001
From: chatgptyukkuri <chatgptyukkuri@gmail.com>
Date: Thu, 29 Oct 2026 13:21:34 +0000
Subject: [PATCH 2/5] dxgi: Implement CreateSwapChainForComposition() for
 Direct3D 10 and 11 devices.

The swapchain gets a hidden window, because wined3d needs one, but
presenting doesn't draw to it. Instead the swapchain calls the
IWineDXGICompositionCallback that the compositor attached to it with
SetPrivateDataInterface(), and the compositor reads buffer 0.

The buffers aren't rotated. Present1() has to keep the contents outside
the dirty rectangles from the previous frame, which this does trivially;
Chromium relies on it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01LkAyMz3ChWUcwV1bWoNa1Z
---
 dlls/dxgi/dxgi_private.h  |  5 ++++
 dlls/dxgi/factory.c       | 53 +++++++++++++++++++++++++++++++++++++--
 dlls/dxgi/swapchain.c     | 44 +++++++++++++++++++++++++++++---
 include/wine/winedxgi.idl | 13 ++++++++++
 4 files changed, 110 insertions(+), 5 deletions(-)

diff --git a/dlls/dxgi/dxgi_private.h b/dlls/dxgi/dxgi_private.h
index 6ecd575..4a48039 100644
--- a/dlls/dxgi/dxgi_private.h
+++ b/dlls/dxgi/dxgi_private.h
@@ -186,10 +186,15 @@ struct d3d11_swapchain
     IDXGIOutput *target;
     LONG present_count;
     LONG in_set_fullscreen_state;
+
+    /* Hidden window owned by swapchains created for composition. */
+    HWND composition_window;
+    DXGI_ALPHA_MODE composition_alpha_mode;
 };
 
 HRESULT d3d11_swapchain_init(struct d3d11_swapchain *swapchain, struct dxgi_device *device,
         struct wined3d_swapchain_desc *desc, const DXGI_SWAP_CHAIN_FULLSCREEN_DESC *fullscreen_desc);
+struct d3d11_swapchain *unsafe_impl_from_IDXGISwapChain1(IDXGISwapChain1 *iface);
 
 HRESULT d3d12_swapchain_create(IWineDXGIFactory *factory, ID3D12CommandQueue *queue, HWND window,
         const DXGI_SWAP_CHAIN_DESC1 *swapchain_desc, const DXGI_SWAP_CHAIN_FULLSCREEN_DESC *fullscreen_desc,
diff --git a/dlls/dxgi/factory.c b/dlls/dxgi/factory.c
index c6bb47f..5cbb6be 100644
--- a/dlls/dxgi/factory.c
+++ b/dlls/dxgi/factory.c
@@ -390,10 +390,59 @@ static void STDMETHODCALLTYPE dxgi_factory_UnregisterOcclusionStatus(IWineDXGIFa
 static HRESULT STDMETHODCALLTYPE dxgi_factory_CreateSwapChainForComposition(IWineDXGIFactory *iface,
         IUnknown *device, const DXGI_SWAP_CHAIN_DESC1 *desc, IDXGIOutput *output, IDXGISwapChain1 **swapchain)
 {
-    FIXME("iface %p, device %p, desc %p, output %p, swapchain %p stub!\n",
+    IWineDXGISwapChainFactory *swapchain_factory;
+    struct d3d11_swapchain *object;
+    HWND window;
+    HRESULT hr;
+
+    TRACE("iface %p, device %p, desc %p, output %p, swapchain %p.\n",
             iface, device, desc, output, swapchain);
 
-    return E_NOTIMPL;
+    if (!device || !desc || !swapchain)
+    {
+        WARN("Invalid pointer.\n");
+        return DXGI_ERROR_INVALID_CALL;
+    }
+
+    if (desc->SwapEffect != DXGI_SWAP_EFFECT_FLIP_SEQUENTIAL && desc->SwapEffect != DXGI_SWAP_EFFECT_FLIP_DISCARD)
+    {
+        WARN("Invalid swap effect %#x.\n", desc->SwapEffect);
+        return DXGI_ERROR_INVALID_CALL;
+    }
+
+    if (!desc->Width || !desc->Height)
+    {
+        WARN("Invalid size %ux%u.\n", desc->Width, desc->Height);
+        return DXGI_ERROR_INVALID_CALL;
+    }
+
+    if (FAILED(IUnknown_QueryInterface(device, &IID_IWineDXGISwapChainFactory, (void **)&swapchain_factory)))
+    {
+        FIXME("Composition swapchains are only implemented for Direct3D 10 and 11 devices.\n");
+        return E_NOTIMPL;
+    }
+    IWineDXGISwapChainFactory_Release(swapchain_factory);
+
+    /* wined3d swapchains need a window, but it is never shown or presented
+     * to. The image is shown by the compositor instead. */
+    if (!(window = CreateWindowA("static", "DXGI composition window", WS_POPUP | WS_DISABLED,
+            0, 0, desc->Width, desc->Height, NULL, NULL, NULL, NULL)))
+    {
+        ERR("Failed to create a window.\n");
+        return E_FAIL;
+    }
+
+    if (FAILED(hr = dxgi_factory_CreateSwapChainForHwnd(iface, device, window, desc, NULL, output, swapchain)))
+    {
+        DestroyWindow(window);
+        return hr;
+    }
+
+    object = unsafe_impl_from_IDXGISwapChain1(*swapchain);
+    object->composition_window = window;
+    object->composition_alpha_mode = desc->AlphaMode;
+
+    return S_OK;
 }
 
 static UINT STDMETHODCALLTYPE dxgi_factory_GetCreationFlags(IWineDXGIFactory *iface)
diff --git a/dlls/dxgi/swapchain.c b/dlls/dxgi/swapchain.c
index 1186527..d9ba081 100644
--- a/dlls/dxgi/swapchain.c
+++ b/dlls/dxgi/swapchain.c
@@ -264,6 +264,8 @@ static ULONG STDMETHODCALLTYPE d3d11_swapchain_Release(IDXGISwapChain4 *iface)
         IWineDXGIFactory_Release(swapchain->factory);
         wined3d_swapchain_decref(swapchain->wined3d_swapchain);
         IWineDXGIDevice_Release(device);
+        if (swapchain->composition_window)
+            DestroyWindow(swapchain->composition_window);
     }
 
     return refcount;
@@ -323,6 +325,25 @@ static HRESULT STDMETHODCALLTYPE d3d11_swapchain_GetDevice(IDXGISwapChain4 *ifac
 
 /* IDXGISwapChain1 methods */
 
+/* There is no window to present to; the compositor reads buffer 0 instead.
+ * Not rotating the buffers also keeps the contents outside the dirty
+ * rectangles of the next frame, which Present1() is required to preserve. */
+static HRESULT d3d11_swapchain_present_composition(struct d3d11_swapchain *swapchain)
+{
+    IWineDXGICompositionCallback *callback;
+    UINT size = sizeof(callback);
+
+    if (SUCCEEDED(dxgi_get_private_data(&swapchain->private_store,
+            &IID_IWineDXGICompositionCallback, &size, &callback)))
+    {
+        IWineDXGICompositionCallback_present(callback, (IDXGISwapChain1 *)&swapchain->IDXGISwapChain4_iface);
+        IWineDXGICompositionCallback_Release(callback);
+    }
+
+    InterlockedIncrement(&swapchain->present_count);
+    return S_OK;
+}
+
 static HRESULT d3d11_swapchain_present(struct d3d11_swapchain *swapchain,
         unsigned int sync_interval, unsigned int flags)
 {
@@ -334,7 +355,7 @@ static HRESULT d3d11_swapchain_present(struct d3d11_swapchain *swapchain,
         return DXGI_ERROR_INVALID_CALL;
     }
 
-    if (IsIconic(d3d11_swapchain_get_hwnd(swapchain)))
+    if (!swapchain->composition_window && IsIconic(d3d11_swapchain_get_hwnd(swapchain)))
         return DXGI_STATUS_OCCLUDED;
 
     if (flags & ~(DXGI_PRESENT_TEST | DXGI_PRESENT_ALLOW_TEARING))
@@ -345,6 +366,9 @@ static HRESULT d3d11_swapchain_present(struct d3d11_swapchain *swapchain,
         return S_OK;
     }
 
+    if (swapchain->composition_window)
+        return d3d11_swapchain_present_composition(swapchain);
+
     if (SUCCEEDED(hr = wined3d_swapchain_present(swapchain->wined3d_swapchain, NULL, NULL, NULL, sync_interval, 0)))
         InterlockedIncrement(&swapchain->present_count);
     return hr;
@@ -535,7 +559,7 @@ static HRESULT STDMETHODCALLTYPE d3d11_swapchain_GetDesc(IDXGISwapChain4 *iface,
             wined3d_desc.multisample_type, wined3d_desc.multisample_quality);
     desc->BufferUsage = dxgi_usage_from_wined3d_bind_flags(wined3d_desc.backbuffer_bind_flags);
     desc->BufferCount = wined3d_desc.backbuffer_count;
-    desc->OutputWindow = wined3d_desc.device_window;
+    desc->OutputWindow = swapchain->composition_window ? NULL : wined3d_desc.device_window;
     desc->Windowed = wined3d_desc.windowed;
     desc->SwapEffect = dxgi_swap_effect_from_wined3d(wined3d_desc.swap_effect);
     desc->Flags = dxgi_swapchain_flags_from_wined3d(wined3d_desc.flags);
@@ -682,7 +706,7 @@ static HRESULT STDMETHODCALLTYPE d3d11_swapchain_GetDesc1(IDXGISwapChain4 *iface
     desc->BufferCount = wined3d_desc.backbuffer_count;
     desc->Scaling = DXGI_SCALING_STRETCH;
     desc->SwapEffect = dxgi_swap_effect_from_wined3d(wined3d_desc.swap_effect);
-    desc->AlphaMode = DXGI_ALPHA_MODE_IGNORE;
+    desc->AlphaMode = swapchain->composition_window ? swapchain->composition_alpha_mode : DXGI_ALPHA_MODE_IGNORE;
     desc->Flags = dxgi_swapchain_flags_from_wined3d(wined3d_desc.flags);
 
     return S_OK;
@@ -726,6 +750,13 @@ static HRESULT STDMETHODCALLTYPE d3d11_swapchain_GetHwnd(IDXGISwapChain4 *iface,
         return DXGI_ERROR_INVALID_CALL;
     }
 
+    if (swapchain->composition_window)
+    {
+        WARN("Swapchain was created for composition.\n");
+        *hwnd = NULL;
+        return DXGI_ERROR_INVALID_CALL;
+    }
+
     *hwnd = d3d11_swapchain_get_hwnd(swapchain);
     return S_OK;
 }
@@ -971,6 +1002,13 @@ static const struct IDXGISwapChain4Vtbl d3d11_swapchain_vtbl =
     d3d11_swapchain_SetHDRMetaData,
 };
 
+struct d3d11_swapchain *unsafe_impl_from_IDXGISwapChain1(IDXGISwapChain1 *iface)
+{
+    if (!iface || iface->lpVtbl != (IDXGISwapChain1Vtbl *)&d3d11_swapchain_vtbl)
+        return NULL;
+    return CONTAINING_RECORD(iface, struct d3d11_swapchain, IDXGISwapChain4_iface);
+}
+
 static void STDMETHODCALLTYPE d3d11_swapchain_wined3d_object_released(void *parent)
 {
     struct d3d11_swapchain *swapchain = parent;
diff --git a/include/wine/winedxgi.idl b/include/wine/winedxgi.idl
index fff00de..38e2d7f 100644
--- a/include/wine/winedxgi.idl
+++ b/include/wine/winedxgi.idl
@@ -95,3 +95,16 @@ interface IWineDXGIAdapter : IDXGIAdapter4
 interface IWineDXGIFactory : IDXGIFactory7
 {
 }
+
+/* Implemented by dcomp. It is attached to swapchains created with
+ * CreateSwapChainForComposition() using SetPrivateDataInterface(), and is
+ * called when the swapchain presents. The presented image is in buffer 0. */
+[
+    object,
+    local,
+    uuid(e0363b2f-75bf-49ae-95c0-7f4859828d99)
+]
+interface IWineDXGICompositionCallback : IUnknown
+{
+    void present([in] IDXGISwapChain1 *swapchain);
+}
-- 
