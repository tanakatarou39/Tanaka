+static void test_visual_tree(void)
+{
+    IDCompositionVisual2 *root, *child, *child2;
+    IDCompositionDesktopDevice *device;
+    IDCompositionVisual3 *visual3;
+    HRESULT hr;
+    ULONG ref;
+
+    if (!pDCompositionCreateDevice2)
+    {
+        win_skip("DCompositionCreateDevice2() is not available.\n");
+        return;
+    }
+
+    hr = pDCompositionCreateDevice2(NULL, &IID_IDCompositionDesktopDevice, (void **)&device);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IDCompositionDesktopDevice_CreateVisual(device, &root);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IDCompositionDesktopDevice_CreateVisual(device, &child);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IDCompositionDesktopDevice_CreateVisual(device, &child2);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+
+    /* Chromium casts every visual to IDCompositionVisual3. */
+    hr = IDCompositionVisual2_QueryInterface(root, &IID_IDCompositionVisual3, (void **)&visual3);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IDCompositionVisual3_SetOpacity(visual3, 1.0f);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IDCompositionVisual3_SetVisible(visual3, TRUE);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    IDCompositionVisual3_Release(visual3);
+
+    hr = IDCompositionVisual2_AddVisual(root, (IDCompositionVisual *)child, FALSE, NULL);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IDCompositionVisual2_AddVisual(root, (IDCompositionVisual *)child, FALSE, NULL);
+    ok(hr == E_INVALIDARG, "Got hr %#lx.\n", hr);
+    /* A visual can't contain itself. */
+    hr = IDCompositionVisual2_AddVisual(child, (IDCompositionVisual *)root, FALSE, NULL);
+    ok(hr == E_INVALIDARG, "Got hr %#lx.\n", hr);
+    hr = IDCompositionVisual2_AddVisual(child, (IDCompositionVisual *)child, FALSE, NULL);
+    ok(hr == E_INVALIDARG, "Got hr %#lx.\n", hr);
+    /* The reference visual must be a child. */
+    hr = IDCompositionVisual2_AddVisual(root, (IDCompositionVisual *)child2, TRUE, (IDCompositionVisual *)root);
+    ok(hr == E_INVALIDARG, "Got hr %#lx.\n", hr);
+    hr = IDCompositionVisual2_AddVisual(root, (IDCompositionVisual *)child2, TRUE, (IDCompositionVisual *)child);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+
+    hr = IDCompositionVisual2_RemoveVisual(root, (IDCompositionVisual *)child);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IDCompositionVisual2_RemoveVisual(root, (IDCompositionVisual *)child);
+    ok(hr == E_INVALIDARG, "Got hr %#lx.\n", hr);
+    hr = IDCompositionVisual2_RemoveAllVisuals(root);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+
+    /* The parent holds a reference on its children. */
+    hr = IDCompositionVisual2_AddVisual(root, (IDCompositionVisual *)child, FALSE, NULL);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    IDCompositionVisual2_AddRef(child);
+    ref = IDCompositionVisual2_Release(child);
+    ok(ref == 2, "Got refcount %lu.\n", ref);
+    IDCompositionVisual2_Release(root);
+    ref = IDCompositionVisual2_Release(child);
+    ok(!ref, "Got refcount %lu.\n", ref);
+    IDCompositionVisual2_Release(child2);
+
+    IDCompositionDesktopDevice_Release(device);
+}
+
+static void fill_swapchain(ID3D11Device *device, IDXGISwapChain1 *swapchain, const float *color)
+{
+    ID3D11RenderTargetView *rtv;
+    ID3D11DeviceContext *context;
+    ID3D11Texture2D *buffer;
+    HRESULT hr;
+
+    hr = IDXGISwapChain1_GetBuffer(swapchain, 0, &IID_ID3D11Texture2D, (void **)&buffer);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = ID3D11Device_CreateRenderTargetView(device, (ID3D11Resource *)buffer, NULL, &rtv);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ID3D11Device_GetImmediateContext(device, &context);
+    ID3D11DeviceContext_ClearRenderTargetView(context, rtv, color);
+    ID3D11DeviceContext_Release(context);
+    ID3D11RenderTargetView_Release(rtv);
+    ID3D11Texture2D_Release(buffer);
+}
+
+static void test_swapchain_content(BOOL chromium_window)
+{
+    static const float red[] = {1.0f, 0.0f, 0.0f, 1.0f}, blue[] = {0.0f, 0.0f, 1.0f, 1.0f};
+    IDCompositionDesktopDevice *device;
+    DXGI_SWAP_CHAIN_DESC1 desc = {0};
+    IDCompositionVisual2 *visual;
+    IDCompositionTarget *target;
+    IDXGISwapChain1 *swapchain;
+    ID3D11Device *d3d11_device;
+    IDXGIFactory2 *factory;
+    IDXGIDevice *dxgi_device;
+    HWND hwnd, parent = NULL, window;
+    COLORREF color;
+    HRESULT hr;
+
+    if (!pDCompositionCreateDevice3)
+    {
+        win_skip("DCompositionCreateDevice3() is not available.\n");
+        return;
+    }
+    if (!(d3d11_device = create_d3d11_device()))
+    {
+        skip("Failed to create a D3D11 device.\n");
+        return;
+    }
+    factory = get_factory(d3d11_device);
+
+    desc.Width = 64;
+    desc.Height = 64;
+    desc.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    desc.SampleDesc.Count = 1;
+    desc.BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT;
+    desc.BufferCount = 2;
+    desc.Scaling = DXGI_SCALING_STRETCH;
+    desc.SwapEffect = DXGI_SWAP_EFFECT_FLIP_SEQUENTIAL;
+    desc.AlphaMode = DXGI_ALPHA_MODE_IGNORE;
+
+    desc.SwapEffect = DXGI_SWAP_EFFECT_DISCARD;
+    hr = IDXGIFactory2_CreateSwapChainForComposition(factory, (IUnknown *)d3d11_device, &desc, NULL, &swapchain);
+    ok(hr == DXGI_ERROR_INVALID_CALL, "Got hr %#lx.\n", hr);
+    desc.SwapEffect = DXGI_SWAP_EFFECT_FLIP_SEQUENTIAL;
+
+    hr = IDXGIFactory2_CreateSwapChainForComposition(factory, (IUnknown *)d3d11_device, &desc, NULL, &swapchain);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IDXGISwapChain1_GetHwnd(swapchain, &window);
+    ok(hr == DXGI_ERROR_INVALID_CALL, "Got hr %#lx.\n", hr);
+
+    if (chromium_window)
+    {
+        /* Chromium presents to a child window with these styles. */
+        parent = create_window();
+        hwnd = CreateWindowExA(WS_EX_NOPARENTNOTIFY | WS_EX_LAYERED | WS_EX_TRANSPARENT | WS_EX_NOREDIRECTIONBITMAP,
+                "static", NULL, WS_CHILD | WS_DISABLED | WS_VISIBLE, 0, 0, 200, 200, parent, NULL, NULL, NULL);
+        ok(!!hwnd, "Failed to create a window.\n");
+        flush_events();
+    }
+    else
+    {
+        hwnd = create_window();
+    }
+
+    hr = ID3D11Device_QueryInterface(d3d11_device, &IID_IDXGIDevice, (void **)&dxgi_device);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = pDCompositionCreateDevice3((IUnknown *)dxgi_device, &IID_IDCompositionDesktopDevice, (void **)&device);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    IDXGIDevice_Release(dxgi_device);
+
+    hr = IDCompositionDesktopDevice_CreateTargetForHwnd(device, hwnd, TRUE, &target);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IDCompositionDesktopDevice_CreateVisual(device, &visual);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+
+    /* Present before the swapchain is used, like Chromium does on its first frame. */
+    fill_swapchain(d3d11_device, swapchain, red);
+    hr = IDXGISwapChain1_Present(swapchain, 0, 0);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+
+    hr = IDCompositionVisual2_SetContent(visual, (IUnknown *)swapchain);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IDCompositionTarget_SetRoot(target, (IDCompositionVisual *)visual);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IDCompositionDesktopDevice_Commit(device);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IDCompositionDesktopDevice_WaitForCommitCompletion(device);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+
+    color = get_screen_color(hwnd, 10, 10);
+    ok(color == RGB(0xff, 0, 0), "Got color %#lx.\n", color);
+
+    /* Painting the window doesn't hide the composed image. */
+    InvalidateRect(parent ? parent : hwnd, NULL, TRUE);
+    UpdateWindow(parent ? parent : hwnd);
+    color = get_screen_color(hwnd, 10, 10);
+    ok(color == RGB(0xff, 0, 0), "Got color %#lx.\n", color);
+
+    /* A present shows up without committing. */
+    fill_swapchain(d3d11_device, swapchain, blue);
+    hr = IDXGISwapChain1_Present(swapchain, 0, 0);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    color = get_screen_color(hwnd, 10, 10);
+    ok(color == RGB(0, 0, 0xff), "Got color %#lx.\n", color);
+
+    /* Move the visual. */
+    hr = IDCompositionVisual2_SetOffsetX(visual, 100.0f);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IDCompositionDesktopDevice_Commit(device);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    color = get_screen_color(hwnd, 110, 10);
+    ok(color == RGB(0, 0, 0xff), "Got color %#lx.\n", color);
+
+    IDCompositionVisual2_Release(visual);
+    IDCompositionTarget_Release(target);
+    IDCompositionDesktopDevice_Release(device);
+    IDXGISwapChain1_Release(swapchain);
+    IDXGIFactory2_Release(factory);
+    ID3D11Device_Release(d3d11_device);
+    DestroyWindow(hwnd);
+    if (parent)
+        DestroyWindow(parent);
+}
