+static HRESULT (WINAPI *pDCompositionCreateDevice)(IDXGIDevice *dxgi_device, REFIID iid, void **device);
+static HRESULT (WINAPI *pDCompositionCreateDevice2)(IUnknown *rendering_device, REFIID iid, void **device);
+static HRESULT (WINAPI *pDCompositionCreateDevice3)(IUnknown *rendering_device, REFIID iid, void **device);
+
+static ID3D11Device *create_d3d11_device(void)
+{
+    static const D3D_FEATURE_LEVEL level = D3D_FEATURE_LEVEL_10_0;
+    ID3D11Device *device;
+
+    if (SUCCEEDED(D3D11CreateDevice(NULL, D3D_DRIVER_TYPE_HARDWARE, NULL, D3D11_CREATE_DEVICE_BGRA_SUPPORT,
+            &level, 1, D3D11_SDK_VERSION, &device, NULL, NULL)))
+        return device;
+    if (SUCCEEDED(D3D11CreateDevice(NULL, D3D_DRIVER_TYPE_WARP, NULL, D3D11_CREATE_DEVICE_BGRA_SUPPORT,
+            &level, 1, D3D11_SDK_VERSION, &device, NULL, NULL)))
+        return device;
+    return NULL;
+}
+
+static IDXGIFactory2 *get_factory(ID3D11Device *device)
+{
+    IDXGIFactory2 *factory = NULL;
+    IDXGIAdapter *adapter;
+    IDXGIDevice *dxgi_device;
+    HRESULT hr;
+
+    hr = ID3D11Device_QueryInterface(device, &IID_IDXGIDevice, (void **)&dxgi_device);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IDXGIDevice_GetAdapter(dxgi_device, &adapter);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IDXGIAdapter_GetParent(adapter, &IID_IDXGIFactory2, (void **)&factory);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    IDXGIAdapter_Release(adapter);
+    IDXGIDevice_Release(dxgi_device);
+    return factory;
+}
+
+static void flush_events(void)
+{
+    DWORD end = GetTickCount() + 100;
+    MSG msg;
+
+    while (GetTickCount() < end)
+    {
+        while (PeekMessageA(&msg, 0, 0, 0, PM_REMOVE))
+            DispatchMessageA(&msg);
+        Sleep(10);
+    }
+}
+
+static HWND create_window(void)
+{
+    HWND hwnd = CreateWindowA("static", "dcomp_test", WS_POPUP | WS_VISIBLE, 100, 100, 200, 200,
+            NULL, NULL, NULL, NULL);
+    ok(!!hwnd, "Failed to create a window.\n");
+    flush_events();
+    return hwnd;
+}
+
+/* Composition happens outside of the window's DC on Windows, so read the screen. */
+static COLORREF get_screen_color(HWND hwnd, int x, int y)
+{
+    POINT point = {x, y};
+    COLORREF color;
+    HDC dc;
+
+    flush_events();
+    ClientToScreen(hwnd, &point);
+    dc = GetDC(NULL);
+    color = GetPixel(dc, point.x, point.y);
+    ReleaseDC(NULL, dc);
+    return color;
+}
