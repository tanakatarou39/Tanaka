+static void test_create_device(void)
+{
+    IDCompositionDesktopDevice *desktop_device;
+    IDCompositionDevice3 *device3;
+    IDCompositionDevice2 *device2;
+    IDCompositionDevice *device;
+    ID3D11Device *d3d11_device;
+    IDXGIDevice *dxgi_device;
+    IUnknown *unknown;
+    HRESULT hr;
+
+    if (!(d3d11_device = create_d3d11_device()))
+    {
+        skip("Failed to create a D3D11 device.\n");
+        return;
+    }
+    hr = ID3D11Device_QueryInterface(d3d11_device, &IID_IDXGIDevice, (void **)&dxgi_device);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+
+    hr = pDCompositionCreateDevice(NULL, &IID_IDCompositionDevice, (void **)&device);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    IDCompositionDevice_Release(device);
+
+    hr = pDCompositionCreateDevice(dxgi_device, &IID_IDCompositionDevice, (void **)&device);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IDCompositionDevice_QueryInterface(device, &IID_IUnknown, (void **)&unknown);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(unknown == (IUnknown *)device, "Got unexpected interface %p.\n", unknown);
+    IUnknown_Release(unknown);
+    IDCompositionDevice_Release(device);
+
+    if (!pDCompositionCreateDevice2)
+    {
+        win_skip("DCompositionCreateDevice2() is not available.\n");
+        goto done;
+    }
+
+    hr = pDCompositionCreateDevice2((IUnknown *)dxgi_device, &IID_IDCompositionDesktopDevice,
+            (void **)&desktop_device);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IDCompositionDesktopDevice_QueryInterface(desktop_device, &IID_IDCompositionDevice2, (void **)&device2);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(device2 == (IDCompositionDevice2 *)desktop_device, "Got unexpected interface %p.\n", device2);
+    IDCompositionDevice2_Release(device2);
+    IDCompositionDesktopDevice_Release(desktop_device);
+
+    if (!pDCompositionCreateDevice3)
+    {
+        win_skip("DCompositionCreateDevice3() is not available.\n");
+        goto done;
+    }
+
+    /* This is what Chromium does. */
+    hr = pDCompositionCreateDevice3((IUnknown *)dxgi_device, &IID_IDCompositionDesktopDevice,
+            (void **)&desktop_device);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IDCompositionDesktopDevice_QueryInterface(desktop_device, &IID_IDCompositionDevice3, (void **)&device3);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IDCompositionDevice3_QueryInterface(device3, &IID_IDCompositionDesktopDevice, (void **)&unknown);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(unknown == (IUnknown *)desktop_device, "Got unexpected interface %p.\n", unknown);
+    IUnknown_Release(unknown);
+    IDCompositionDevice3_Release(device3);
+    IDCompositionDesktopDevice_Release(desktop_device);
+
+done:
+    IDXGIDevice_Release(dxgi_device);
+    ID3D11Device_Release(d3d11_device);
+}
