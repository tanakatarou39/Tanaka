+static void test_target(void)
+{
+    IDCompositionTarget *target, *target2, *target3;
+    IDCompositionVisual2 *visual, *visual2;
+    IDCompositionDesktopDevice *device;
+    HWND hwnd;
+    HRESULT hr;
+
+    if (!pDCompositionCreateDevice2)
+    {
+        win_skip("DCompositionCreateDevice2() is not available.\n");
+        return;
+    }
+
+    hr = pDCompositionCreateDevice2(NULL, &IID_IDCompositionDesktopDevice, (void **)&device);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hwnd = create_window();
+
+    hr = IDCompositionDesktopDevice_CreateTargetForHwnd(device, hwnd, TRUE, &target);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IDCompositionDesktopDevice_CreateTargetForHwnd(device, hwnd, TRUE, &target2);
+    ok(hr == DCOMPOSITION_ERROR_WINDOW_ALREADY_COMPOSED, "Got hr %#lx.\n", hr);
+    hr = IDCompositionDesktopDevice_CreateTargetForHwnd(device, hwnd, FALSE, &target2);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+
+    hr = IDCompositionDesktopDevice_CreateVisual(device, &visual);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IDCompositionDesktopDevice_CreateVisual(device, &visual2);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+
+    hr = IDCompositionTarget_SetRoot(target, (IDCompositionVisual *)visual);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IDCompositionTarget_SetRoot(target, (IDCompositionVisual *)visual);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    /* A visual can only be in one tree. */
+    hr = IDCompositionTarget_SetRoot(target2, (IDCompositionVisual *)visual);
+    ok(hr == E_INVALIDARG, "Got hr %#lx.\n", hr);
+    hr = IDCompositionVisual2_AddVisual(visual2, (IDCompositionVisual *)visual, FALSE, NULL);
+    ok(hr == E_INVALIDARG, "Got hr %#lx.\n", hr);
+
+    hr = IDCompositionTarget_SetRoot(target, NULL);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IDCompositionTarget_SetRoot(target2, (IDCompositionVisual *)visual);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+
+    /* The target is gone after the last reference is released. */
+    IDCompositionTarget_Release(target);
+    hr = IDCompositionDesktopDevice_CreateTargetForHwnd(device, hwnd, TRUE, &target3);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    IDCompositionTarget_Release(target3);
+
+    hr = IDCompositionDesktopDevice_Commit(device);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+
+    IDCompositionTarget_Release(target2);
+    IDCompositionVisual2_Release(visual2);
+    IDCompositionVisual2_Release(visual);
+    IDCompositionDesktopDevice_Release(device);
+    DestroyWindow(hwnd);
+}
